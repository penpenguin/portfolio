---
import { withBase } from '../utils/withBase';

interface Props {
  src?: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={['blog-thumbnail', className, { 'post-visual--fallback': !src }]}
>
  {src ? (
    <img
      class="blog-thumbnail__image"
      src={withBase(src)}
      alt={alt}
      decoding="async"
    />
  ) : (
    <span class="post-visual__art" aria-hidden="true">
      {alt}
    </span>
  )}
</div>

<style>
  .blog-thumbnail {
    height: var(--thumbnail-height, 150px);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
    padding: var(--space-sm);
    background: var(--bento-muted-bg);
    border-bottom: 1px solid var(--glass-border);
  }

  .blog-thumbnail__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .post-visual__art {
    color: var(--text-secondary);
    font-family: var(--font-family-japanese);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .post-visual--fallback {
    height: auto;
    min-height: var(--thumbnail-height, 150px);
  }

  @media (max-width: 768px) {
    .blog-thumbnail {
      padding: 0.75rem;
    }
  }
</style>
