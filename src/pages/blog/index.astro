---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import { getCollection } from 'astro:content';
import { sortPublishedPostsByDate } from '../../utils/blog';
import { formatDate } from '../../utils/formatDate';

const blogPosts = await getCollection('blog');
const sortedPosts = sortPublishedPostsByDate(blogPosts);
const latestMonth = sortedPosts[0]
  ? sortedPosts[0].id.split('/').slice(0, 2).join('/')
  : null;
const latestPosts = latestMonth
  ? sortedPosts.filter((post) => post.id.startsWith(`${latestMonth}/`))
  : [];
const months = Array.from(
  new Set(sortedPosts.map((post) => post.id.split('/').slice(0, 2).join('/')))
)
  .sort()
  .reverse();
---

<Layout title="Blog - Portfolio">
  <section class="page-shell blog-shell">
    <div class="container">
      <header class="bento-hero blog-hero card-glass">
        <p class="bento-eyebrow eyebrow">Blog</p>
        <h1>Blog</h1>
        <p>
          ブログや開発に関する記事を公開しています。実装メモや設計の学びを、
          読みやすく短いペースで更新中です。
        </p>
      </header>
      {
        latestPosts.length > 0 ? (
          <>
            <div class="posts-grid">
              {latestPosts.map((post) => (
                <article class="bento-panel post-card card card-glass">
                  <div class="post-header">
                    {post.data.heroImage && (
                      <img
                        src={post.data.heroImage}
                        alt={post.data.title}
                        class="post-image"
                      />
                    )}
                    <div class="post-meta">
                      <h2>
                        <Link href={`/blog/${post.id}`}>{post.data.title}</Link>
                      </h2>
                      <p class="post-date">{formatDate(post.data.pubDate)}</p>
                    </div>
                  </div>

                  <div class="post-content">
                    <p class="post-description">{post.data.description}</p>

                    {post.data.tags && (
                      <div class="pill-list post-tags">
                        {post.data.tags.map((tag) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    )}

                    <Link
                      href={`/blog/${post.id}`}
                      class="read-more btn btn-glass"
                    >
                      Read More →
                    </Link>
                  </div>
                </article>
              ))}
            </div>
            {months.length > 0 && (
              <div class="archive">
                <h2>月別アーカイブ</h2>
                <ul class="month-list">
                  {months.map((month) => (
                    <li>
                      <Link href={`/blog/${month}`}>{month}</Link>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        ) : (
          <div class="bento-panel empty-state card-glass">
            <div class="empty-content">
              <div class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path
                    d="M7 4.5h7l3 3v12H7v-15Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M14 4.5v3h3M9.75 11.5h4.5M9.75 14.5h4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <h2>準備中</h2>
              <p>
                現在、皆様に役立つコンテンツを準備しています。
                Web開発に関する記事やチュートリアルなどを順次公開予定です！
              </p>
              <Link href="/contact" class="btn btn-primary">
                トピックをご提案
              </Link>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    min-height: 280px;
    margin-bottom: var(--space-md);
  }

  .blog-hero h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .blog-hero p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-md);
  }

  .post-card {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .post-card:hover {
    transform: translateY(-2px);
  }

  .post-header {
    position: relative;
  }

  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .post-meta {
    padding: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .post-meta h2 {
    margin: 0 0 var(--space-xs) 0;
  }

  .post-meta h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-meta h2 a:hover {
    color: var(--text-accent);
  }

  .post-date {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .post-content {
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .post-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .post-tags {
    margin-bottom: var(--space-lg);
  }

  .tag {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .read-more {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .archive {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--glass-border);
  }

  .archive h2 {
    margin: 0 0 var(--space-md) 0;
    font-size: var(--font-size-2xl);
  }

  .month-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .month-list a {
    display: inline-flex;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
    background: var(--bento-muted-bg);
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .month-list a:hover {
    color: var(--text-accent);
    border-color: var(--text-accent);
  }

  .empty-state {
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .empty-icon {
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .empty-icon svg {
    width: 64px;
    height: 64px;
    display: block;
  }

  .empty-content h2 {
    color: var(--text-primary);
    font-size: var(--font-size-3xl);
    margin: 0;
  }

  .empty-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-lg) 0;
  }

  @media (max-width: 768px) {
    .blog-hero h1 {
      font-size: var(--font-size-4xl);
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .empty-state {
      padding: var(--space-lg);
    }
  }
</style>
