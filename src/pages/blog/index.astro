---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import BlogThumbnail from '../../components/BlogThumbnail.astro';
import { sortPublishedPostsByDate } from '../../utils/blog';
import { formatDate } from '../../utils/formatDate';

const blogPosts = await getCollection('blog');
const sortedPosts = sortPublishedPostsByDate(blogPosts);
const latestMonth = sortedPosts[0]
  ? sortedPosts[0].id.split('/').slice(0, 2).join('/')
  : null;
const latestPosts = latestMonth
  ? sortedPosts.filter((post) => post.id.startsWith(`${latestMonth}/`))
  : [];
const featuredPost = latestPosts[0];
const secondaryPosts = latestPosts.slice(1);
const months = Array.from(
  new Set(sortedPosts.map((post) => post.id.split('/').slice(0, 2).join('/')))
)
  .sort()
  .reverse();
---

<Layout title="Blog - Portfolio">
  <section class="page-shell blog-shell">
    <div class="container">
      <header class="bento-hero blog-hero card-glass">
        <h1>Blog</h1>
        <p>
          Development notes, implementation details, and design learnings,
          updated in short readable entries.
        </p>
      </header>
      {latestPosts.length > 0 ? (
        <div class="bento-grid blog-bento">
          {featuredPost && (
            <article class="bento-panel post-card post-card--featured card card-glass">
              <div class="post-header">
                <BlogThumbnail
                  src={featuredPost.data.heroImage}
                  tone={featuredPost.data.thumbnailTone}
                  loading="eager"
                  alt={featuredPost.data.title}
                  class="post-visual"
                />
                <div class="post-meta">
                  <h2>
                    <Link href={`/blog/${featuredPost.id}`}>
                      {featuredPost.data.title}
                    </Link>
                  </h2>
                  <time
                    class="post-date"
                    datetime={featuredPost.data.pubDate.toISOString()}
                  >
                    {formatDate(featuredPost.data.pubDate)}
                  </time>
                </div>
              </div>

              <div class="post-content">
                <p class="post-description">{featuredPost.data.description}</p>

                {featuredPost.data.tags && (
                  <div class="pill-list post-tags">
                    {featuredPost.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <Link href={`/blog/${featuredPost.id}`} class="read-more">
                  <span class="read-more__label">
                    記事を読む <span aria-hidden="true">→</span>
                  </span>
                </Link>
              </div>
            </article>
          )}
          <BlogArchive months={months} />
          {secondaryPosts.map((post) => (
            <article class="bento-panel post-card card card-glass">
              <div class="post-header">
                <BlogThumbnail
                  src={post.data.heroImage}
                  tone={post.data.thumbnailTone}
                  alt={post.data.title}
                  class="post-visual"
                />
                <div class="post-meta">
                  <h2>
                    <Link href={`/blog/${post.id}`}>{post.data.title}</Link>
                  </h2>
                  <time
                    class="post-date"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
              </div>

              <div class="post-content">
                <p class="post-description">{post.data.description}</p>

                {post.data.tags && (
                  <div class="pill-list post-tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <Link href={`/blog/${post.id}`} class="read-more">
                  <span class="read-more__label">
                    記事を読む <span aria-hidden="true">→</span>
                  </span>
                </Link>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="bento-panel empty-state card-glass">
          <div class="empty-content">
            <div class="empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path
                  d="M7 4.5h7l3 3v12H7v-15Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
                <path
                  d="M14 4.5v3h3M9.75 11.5h4.5M9.75 14.5h4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <h2>準備中</h2>
            <p>
              現在、皆様に役立つコンテンツを準備しています。
              Web開発に関する記事やチュートリアルなどを順次公開予定です！
            </p>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    margin-bottom: var(--grid-gap);
  }

  .blog-hero h1 {
    font-size: clamp(3.5rem, 5.5vw, 5rem);
    margin-bottom: 0;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .blog-hero p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .blog-bento {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .post-card {
    align-self: stretch;
    grid-column: span 4;
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .post-card--featured {
    grid-column: span 8;
    background: var(--bento-card-bg);
  }

  .post-header {
    position: relative;
  }

  .post-visual {
    width: 100%;
    --thumbnail-height: 150px;
  }

  .post-card--featured .post-visual {
    --thumbnail-height: 260px;
  }

  .post-meta {
    padding: var(--card-padding);
    padding-bottom: var(--space-md);
  }

  .post-meta h2 {
    margin: 0 0 var(--space-xs) 0;
    font-family: var(--font-family-japanese);
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .post-card--featured .post-meta h2 {
    font-size: 1.625rem;
  }

  .post-meta h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-meta h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--text-primary);
  }

  .post-date {
    display: block;
    font-family: var(--font-family-mono);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    margin: 0;
  }

  .post-content {
    padding: 0 var(--card-padding) var(--card-padding);
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .post-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    display: -webkit-box;
    overflow: hidden;
    line-height: 1.85;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-card--featured .post-description {
    -webkit-line-clamp: 4;
  }

  .post-tags {
    margin-bottom: var(--space-lg);
  }

  .tag {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }

  .read-more {
    align-self: flex-start;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-secondary);
    margin-top: auto;
    padding: var(--space-xs) 0;
    font-size: var(--font-size-sm);
    display: inline-flex;
    align-items: center;
  }

  .read-more__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding-bottom: 0.12em;
    border-bottom: 1px solid currentColor;
    line-height: 1.4;
  }

  .empty-state {
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .empty-icon {
    margin-bottom: var(--space-md);
    color: var(--text-primary);
  }

  .empty-icon svg {
    width: 64px;
    height: 64px;
    display: block;
  }

  .empty-content h2 {
    color: var(--text-primary);
    font-size: var(--font-size-3xl);
    margin: 0;
  }

  .empty-content p {
    color: var(--text-secondary);
    line-height: 1.85;
    margin: 0 0 var(--space-lg) 0;
  }

  @media (max-width: 768px) {
    .blog-hero h1 {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }
    .post-meta h2,
    .post-card--featured .post-meta h2 {
      font-size: 1.375rem;
    }

    .blog-bento {
      grid-template-columns: 1fr;
    }

    .post-card,
    .post-card--featured {
      grid-column: span 1;
    }

    .post-card--featured .post-visual {
      --thumbnail-height: 180px;
    }

    .empty-state {
      padding: var(--card-padding);
    }
  }
</style>
