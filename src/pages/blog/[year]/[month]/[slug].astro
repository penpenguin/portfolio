---
import Layout from '../../../../layouts/Layout.astro';
import Link from '../../../../components/Link.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatDate } from '../../../../utils/formatDate';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => {
    const [year, month, ...rest] = post.id.split('/');
    const slug = rest.join('/');

    return { params: { year, month, slug } };
  });
}

const year = Astro.params.year;
const month = Astro.params.month;
const slug = Astro.params.slug;

if (!year || !month || !slug) {
  throw new Response(null, { status: 404 });
}

const id = `${year}/${month}/${slug}`;
const entry = await getEntry('blog', id);

if (!entry) {
  throw new Response(null, { status: 404 });
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  impression,
} = entry.data;
const { Content } = await render(entry);
const heroClass = heroImage
  ? 'article-hero'
  : 'article-hero article-hero--single';
---

<Layout title={`${title} - Blog`} description={description}>
  <article class="blog-article">
    <header class="article-header">
      <div class="container">
        <p class="breadcrumb">
          <Link href="/blog" class="btn btn-glass">← ブログ一覧に戻る</Link>
          <span class="sr-only"> / {title}</span>
        </p>

        <div class={`bento-hero ${heroClass} card-glass`}>
          <div class="article-meta">
            <h1>{title}</h1>
            <p class="article-description">{description}</p>

            <div class="meta">
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time
              >
              {
                updatedDate && (
                  <span class="updated">Updated {formatDate(updatedDate)}</span>
                )
              }
            </div>

            {
              tags && (
                <div class="pill-list tag-list" aria-label="Tags">
                  {tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )
            }
          </div>

          {
            heroImage && (
              <div class="hero-wrapper">
                <img src={heroImage} alt={title} loading="lazy" />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <section class="article-body">
      <div class="container">
        <div class="bento-panel content-wrapper card-glass">
          <Content />
        </div>
      </div>
    </section>

    <footer class="article-footer">
      <div class="container">
        {
          impression && (
            <aside class="author-impression" aria-label="Author note">
              <img
                class="author-impression__avatar"
                src="https://github.com/penpenguin.png?size=64"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div class="author-impression__content">
                <p class="author-impression__label">My note</p>
                <p class="author-impression__text">{impression}</p>
              </div>
            </aside>
          )
        }
        <Link href="/blog" class="btn btn-glass">← ブログ一覧に戻る</Link>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .blog-article {
    padding-top: var(--space-xl);
  }

  .article-header {
    margin-bottom: var(--space-2xl);
  }

  .breadcrumb {
    margin: 0 0 var(--space-lg) 0;
  }

  .breadcrumb .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  .article-footer .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  .author-impression {
    margin: 0 0 var(--space-md) 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: start;
  }

  .author-impression__avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid rgba(31, 35, 40, 0.2);
    display: block;
    margin-top: 6px;
  }

  .author-impression__content {
    position: relative;
    isolation: isolate;
    min-width: 0;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background: var(--bento-card-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-sm);
  }

  .author-impression__label {
    margin: 0 0 4px 0;
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .author-impression__text {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.65;
  }

  .article-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .article-hero--single {
    grid-template-columns: 1fr;
    text-align: left;
    justify-items: start;
  }

  .article-meta h1 {
    margin: 0 0 var(--space-md) 0;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .article-description {
    margin: 0 0 var(--space-md) 0;
    color: var(--text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .meta {
    display: flex;
    gap: var(--space-md);
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    align-items: center;
  }

  .updated {
    background: var(--bento-muted-bg);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .tag-list {
  }

  .tag {
    background: var(--bento-muted-bg);
    color: var(--text-accent);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    font-size: var(--font-size-xs);
    border: 1px solid var(--glass-border);
  }

  .hero-wrapper {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bento-muted-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
  }

  .hero-wrapper img {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .article-body {
    padding: 0 0 var(--space-2xl) 0;
  }

  .content-wrapper {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    border-radius: var(--radius-xl);
    line-height: 1.85;
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
  }

  .content-wrapper :global(h1),
  .content-wrapper :global(h2),
  .content-wrapper :global(h3),
  .content-wrapper :global(h4),
  .content-wrapper :global(h5),
  .content-wrapper :global(h6) {
    color: var(--text-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .content-wrapper :global(h2):first-child,
  .content-wrapper :global(h3):first-child {
    margin-top: 0;
  }

  .content-wrapper :global(h2) {
    font-size: clamp(var(--font-size-2xl), 3vw, var(--font-size-3xl));
    padding-top: var(--space-lg);
    border-top: 1px solid var(--glass-border);
  }

  .content-wrapper :global(h2):first-child {
    padding-top: 0;
    border-top: 0;
  }

  .content-wrapper :global(h3) {
    font-size: var(--font-size-2xl);
  }

  .content-wrapper :global(p) {
    color: var(--text-secondary);
    margin: 0 0 var(--space-md) 0;
    line-height: 1.85;
  }

  .content-wrapper :global(ul),
  .content-wrapper :global(ol) {
    padding-left: var(--space-xl);
    color: var(--text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .content-wrapper :global(li) {
    margin-bottom: var(--space-xs);
  }

  .content-wrapper :global(pre) {
    background: var(--bento-muted-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin: var(--space-lg) 0;
    white-space: pre;
    word-break: normal;
  }

  .content-wrapper :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
    font-size: 0.95em;
  }

  .content-wrapper :global(p code),
  .content-wrapper :global(li code),
  .content-wrapper :global(td code),
  .content-wrapper :global(th code) {
    padding: 0.12em 0.42em;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-sm);
    background: var(--bento-muted-bg);
    color: var(--text-primary);
    font-size: 0.92em;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .content-wrapper :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
    white-space: inherit;
  }

  .content-wrapper :global(blockquote) {
    border-left: 4px solid var(--text-accent);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .content-wrapper :global(table) {
    width: max-content;
    min-width: 100%;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    border-spacing: 0;
    border-collapse: separate;
    background: var(--bento-card-bg);
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    margin: var(--space-lg) 0;
  }

  .content-wrapper :global(thead) {
    background: var(--bento-muted-bg);
  }

  .content-wrapper :global(th),
  .content-wrapper :global(td) {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--glass-border);
    text-align: left;
    vertical-align: top;
    line-height: 1.65;
    min-width: 9rem;
  }

  .content-wrapper :global(th) {
    color: var(--text-primary);
    font-weight: 700;
    font-size: var(--font-size-sm);
  }

  .content-wrapper :global(td) {
    font-size: var(--font-size-sm);
  }

  .content-wrapper :global(th:not(:last-child)),
  .content-wrapper :global(td:not(:last-child)) {
    border-right: 1px solid var(--glass-border);
  }

  .content-wrapper :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .content-wrapper :global(tbody tr:hover) {
    background: var(--bento-muted-bg);
  }

  .content-wrapper :global(.admonition) {
    --admonition-color: #0969da;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-xs);
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    border-left: 3px solid var(--admonition-color);
    background: color-mix(
      in srgb,
      var(--bento-card-bg) 92%,
      var(--admonition-color) 8%
    );
    margin: var(--space-lg) 0;
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
  }

  .content-wrapper :global(.admonition)::after {
    content: attr(data-label);
    color: var(--admonition-color);
    font-weight: 700;
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    grid-column: 1;
    grid-row: 1;
  }

  .content-wrapper :global(.admonition p),
  .content-wrapper :global(.admonition ul),
  .content-wrapper :global(.admonition ol) {
    grid-column: 1;
    margin: 0;
    color: var(--text-secondary);
  }

  .content-wrapper :global(.admonition-note) {
    --admonition-color: #58a6ff;
  }

  .content-wrapper :global(.admonition-tip) {
    --admonition-color: #3fb950;
  }

  .content-wrapper :global(.admonition-important) {
    --admonition-color: #a371f7;
  }

  .content-wrapper :global(.admonition-warning) {
    --admonition-color: #d29922;
  }

  .content-wrapper :global(.admonition-caution) {
    --admonition-color: #f85149;
  }

  .article-footer {
    padding-bottom: var(--space-2xl);
  }

  @media (max-width: 768px) {
    .article-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .article-meta h1 {
      font-size: var(--font-size-3xl);
    }

    .meta {
      flex-direction: column;
      align-items: center;
    }

    .tag-list {
      justify-content: center;
    }

    .hero-wrapper {
      order: -1;
    }

    .content-wrapper {
      padding: var(--space-lg);
      border-radius: var(--radius-lg);
    }

    .content-wrapper :global(th),
    .content-wrapper :global(td) {
      padding: var(--space-xs) var(--space-sm);
      min-width: 8rem;
    }

    .author-impression__avatar {
      margin: 0 0 2px 0;
    }
  }
</style>
