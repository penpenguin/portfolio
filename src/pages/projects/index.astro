---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';

const projects = await getCollection('projects');
---

<Layout title="Projects - Portfolio">
  <section class="page-shell projects-shell">
    <div class="container">
      <header class="bento-hero projects-hero card-glass">
        <p class="bento-eyebrow eyebrow">Projects</p>
        <h1>My Projects</h1>
        <p>作品集</p>
      </header>
      <div class="bento-grid projects-bento">
        {
          projects.map((project, index) => (
            <article class="bento-panel project-card card card-glass">
              <div class="project-header">
                {project.data.heroImage && (
                  <img
                    src={project.data.heroImage}
                    alt={project.data.title}
                    class="project-image"
                  />
                )}
                <div class="project-meta">
                  <span class="bento-eyebrow project-number">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h2>
                    <Link href={`/projects/${project.id}`}>
                      {project.data.title}
                    </Link>
                  </h2>
                  <p class="project-date">{formatDate(project.data.pubDate)}</p>
                </div>
              </div>

              <div class="project-content">
                <p class="project-description">{project.data.description}</p>

                {project.data.tags && (
                  <div class="pill-list project-tags">
                    {project.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <div class="project-links">
                  {project.data.link && (
                    <a
                      href={project.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-glass"
                    >
                      ライブ版を見る
                    </a>
                  )}
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-glass"
                    >
                      コードを見る
                    </a>
                  )}
                  <Link
                    href={`/projects/${project.id}`}
                    class="btn btn-primary"
                  >
                    詳細を見る
                  </Link>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height: 280px;
    margin-bottom: var(--space-md);
  }

  .projects-hero h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .projects-hero p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .eyebrow,
  .project-number {
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .projects-bento {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .project-card:hover {
    transform: translateY(-2px);
  }

  .project-header {
    position: relative;
  }

  .project-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .project-meta {
    padding: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .project-meta h2 {
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--font-size-2xl);
  }

  .project-meta h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-meta h2 a:hover {
    color: var(--text-accent);
  }

  .project-date {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .project-content {
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .project-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .project-tags {
    margin-bottom: var(--space-lg);
  }

  .tag {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .project-links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-links .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .projects-hero h1 {
      font-size: var(--font-size-4xl);
    }

    .project-links {
      flex-direction: column;
    }

    .project-links .btn {
      text-align: center;
    }
  }
</style>
