---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import { withBase } from '../../utils/withBase';

const projects = await getCollection('projects');
const sortedProjects = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout title="Projects - Portfolio">
  <section class="page-shell projects-shell">
    <div class="container">
      <header class="bento-hero projects-hero card-glass">
        <h1>Built Systems</h1>
        <p>
          音楽ツール、Webアプリ、運用支援まで。実装したものを、設計意図と動作する形で残しています。
        </p>
      </header>
      <div class="bento-grid projects-bento">
        {
          sortedProjects.map((project, index) => (
            <article
              class:list={[
                'bento-panel project-card card card-glass',
                { 'project-card--featured': index === 0 },
              ]}
            >
              <div class="project-header">
                {project.data.heroImage ? (
                  <img
                    src={withBase(project.data.heroImage)}
                    alt={project.data.title}
                    class="project-image"
                  />
                ) : (
                  <div class="project-card__fallback-visual" aria-hidden="true">
                    <div class="project-card__fallback-art" />
                  </div>
                )}
                <div class="project-meta">
                  <h2>
                    <Link href={`/projects/${project.id}`}>
                      {project.data.title}
                    </Link>
                  </h2>
                  <p class="project-card-meta">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <span>{formatDate(project.data.pubDate)}</span>
                  </p>
                </div>
              </div>

              <div class="project-content project-summary">
                <p class="project-description">{project.data.description}</p>

                {project.data.tags && (
                  <div class="pill-list project-tags">
                    {project.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <div class="project-links">
                  {project.data.link && (
                    <a
                      href={project.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-glass"
                    >
                      ライブ版を見る
                    </a>
                  )}
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-glass"
                    >
                      コードを見る
                    </a>
                  )}
                  <Link
                    href={`/projects/${project.id}`}
                    class="btn btn-primary"
                  >
                    詳細を見る
                  </Link>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height: 280px;
    margin-bottom: var(--space-md);
  }

  .projects-hero h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .projects-hero p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .project-card-meta {
    display: flex;
    gap: var(--space-xs);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .projects-bento {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .project-card--featured {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .project-card:hover {
    transform: translateY(-1px);
  }

  .project-header {
    position: relative;
  }

  .project-card--featured .project-meta {
    max-width: 760px;
  }

  .project-image {
    display: block;
    width: 100%;
    height: 220px;
    padding: var(--space-sm);
    background: var(--bento-muted-bg);
    border-bottom: 1px solid var(--glass-border);
    object-fit: cover;
    object-position: top;
  }

  .project-card__fallback-visual {
    position: relative;
    height: 220px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(14, 165, 233, 0.14), transparent 44%),
      linear-gradient(180deg, var(--bento-card-bg), var(--bento-muted-bg));
  }

  .project-card__fallback-visual::before {
    content: '';
    position: absolute;
    inset: var(--space-lg);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    opacity: 0.58;
  }

  .project-card__fallback-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 24% 28%,
        rgba(20, 184, 166, 0.18),
        transparent 28%
      ),
      radial-gradient(
        circle at 78% 20%,
        rgba(129, 140, 248, 0.16),
        transparent 24%
      ),
      linear-gradient(
        115deg,
        transparent 0 34%,
        rgba(255, 255, 255, 0.62) 34% 62%,
        transparent 62%
      ),
      linear-gradient(
        155deg,
        rgba(14, 165, 233, 0.14),
        rgba(20, 184, 166, 0.08)
      );
  }

  .project-card__fallback-art::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(90deg, rgba(15, 23, 42, 0.07), transparent 62%);
  }

  .project-card--featured .project-image {
    height: 320px;
    min-height: 360px;
  }

  .project-card--featured .project-card__fallback-visual {
    height: 320px;
    min-height: 360px;
  }

  .project-meta {
    padding: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .project-meta h2 {
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--font-size-2xl);
  }

  .project-meta h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-meta h2 a:hover {
    color: var(--text-accent);
  }

  .project-content {
    padding: 0 var(--space-lg) var(--space-lg);
  }

  .project-card--featured .project-content {
    padding-top: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .project-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .project-card--featured .project-description {
    max-width: 760px;
    font-size: var(--font-size-lg);
  }

  .project-tags {
    margin-bottom: var(--space-lg);
  }

  .tag {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .project-links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-links .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .projects-bento {
      grid-template-columns: 1fr;
    }

    .project-card--featured {
      grid-column: span 1;
    }

    .projects-hero h1 {
      font-size: var(--font-size-4xl);
    }

    .project-card--featured .project-image {
      min-height: 220px;
    }

    .project-card--featured .project-card__fallback-visual {
      min-height: 220px;
    }

    .project-links {
      flex-direction: column;
    }

    .project-links .btn {
      text-align: center;
    }
  }
</style>
