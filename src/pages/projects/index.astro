---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import { withBase } from '../../utils/withBase';

const projects = await getCollection('projects');
const sortedProjects = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout title="Projects - Portfolio">
  <section class="page-shell projects-shell">
    <div class="container">
      <header class="bento-hero projects-hero card-glass">
        <h1>Built Systems</h1>
        <p>
          Music tools, web apps, and operations support, documented with design
          intent and working outputs.
        </p>
      </header>
      <div class="bento-grid projects-bento">
        {sortedProjects.map((project, index) => (
          <article
            class:list={[
              'bento-panel project-card card card-glass',
              { 'project-card--featured': index === 0 },
            ]}
          >
            <div class="project-header">
              {project.data.heroImage ? (
                <img
                  src={withBase(project.data.heroImage)}
                  alt={project.data.title}
                  class="project-image"
                />
              ) : (
                <div class="project-card__fallback-visual" aria-hidden="true">
                  <span class="project-card__fallback-art">
                    {project.data.title}
                  </span>
                </div>
              )}
              <div class="project-meta">
                <h2>
                  <Link href={`/projects/${project.id}`}>
                    {project.data.title}
                  </Link>
                </h2>
                <p class="project-card-meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <time datetime={project.data.pubDate.toISOString()}>
                    {formatDate(project.data.pubDate)}
                  </time>
                </p>
              </div>
            </div>

            <div class="project-content project-summary">
              <p class="project-description">{project.data.description}</p>

              {project.data.tags && (
                <div class="pill-list project-tags">
                  {project.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}

              <div class="project-links">
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-glass"
                  >
                    ライブ版を見る
                  </a>
                )}
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-glass"
                  >
                    コードを見る
                  </a>
                )}
                <Link href={`/projects/${project.id}`} class="btn btn-primary">
                  詳細を見る
                </Link>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height: 280px;
    margin-bottom: var(--grid-gap);
  }

  .projects-hero h1 {
    font-size: clamp(3.5rem, 5.5vw, 5rem);
    margin-bottom: var(--space-md);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .projects-hero p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .project-card-meta {
    flex-wrap: wrap;
    font-family: var(--font-family-mono);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    gap: var(--space-xs);
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin: 0;
  }

  .projects-bento {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .project-card--featured {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .project-header {
    position: relative;
  }

  .project-card--featured .project-meta {
    max-width: 760px;
  }

  .project-image {
    display: block;
    width: 100%;
    height: 220px;
    padding: var(--space-sm);
    background: var(--bento-muted-bg);
    border-bottom: 1px solid var(--glass-border);
    object-fit: contain;
    object-position: center;
  }

  .project-card__fallback-visual {
    display: flex;
    align-items: center;
    min-height: 220px;
    padding: var(--space-sm);
    background: var(--bento-muted-bg);
    border-bottom: 1px solid var(--glass-border);
  }

  .project-card__fallback-art {
    color: var(--text-secondary);
    font-family: var(--font-family-heading);
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .project-card--featured .project-image {
    height: 360px;
  }

  .project-card--featured .project-card__fallback-visual {
    min-height: 360px;
  }

  .project-meta {
    padding: var(--card-padding);
    padding-bottom: var(--space-md);
  }

  .project-meta h2 {
    margin: 0 0 var(--space-xs) 0;
    font-size: 1.875rem;
    line-height: 1.35;
  }

  .project-meta h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-meta h2 a:hover {
    color: var(--text-primary);
  }

  .project-content {
    padding: 0 var(--card-padding) var(--card-padding);
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .project-card--featured .project-content {
    padding-top: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .project-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .project-card--featured .project-description {
    max-width: 760px;
    font-size: var(--font-size-base);
  }

  .project-tags {
    margin-bottom: var(--space-lg);
  }

  .tag {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }

  .project-links {
    margin-top: auto;
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-links .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .projects-bento {
      grid-template-columns: 1fr;
    }

    .project-card--featured {
      grid-column: span 1;
    }

    .projects-hero {
      min-height: auto;
    }
    .projects-hero h1 {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }
    .project-meta h2 {
      font-size: 1.625rem;
    }
    .project-image,
    .project-card__fallback-visual {
      padding: 0.75rem;
    }

    .project-card--featured .project-image {
      height: 220px;
    }

    .project-card--featured .project-card__fallback-visual {
      min-height: 220px;
    }

    .project-links {
      flex-direction: column;
    }

    .project-links .btn {
      text-align: center;
    }
  }
</style>
