---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/formatDate';
import BlogThumbnail from '../../components/BlogThumbnail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const project = Astro.props;
const { Content } = await render(project);
const heroImage = project.data.heroImage?.trim();
const projectHeroClass = heroImage
  ? 'project-hero'
  : 'project-hero project-hero--single';
---

<Layout title={`${project.data.title} - Projects`}>
  <article class="project-detail" data-pagefind-filter="type:Project">
    <header class="project-header">
      <div class="container">
        <div class="breadcrumb">
          <Link href="/projects" class="btn btn-glass">
            ← プロジェクト一覧に戻る
          </Link>
        </div>

        <div class={`bento-hero ${projectHeroClass} card-glass`}>
          <div class="project-meta">
            <h1
              data-pagefind-meta={`title, date:${project.data.pubDate.toISOString().slice(0, 10)}`}
            >
              {project.data.title}
            </h1>
            <div class="project-date">
              Published:{' '}
              <time datetime={project.data.pubDate.toISOString()}>
                {formatDate(project.data.pubDate)}
              </time>
              {project.data.updatedDate && (
                <span class="updated">
                  • Updated:{' '}
                  <time datetime={project.data.updatedDate.toISOString()}>
                    {formatDate(project.data.updatedDate)}
                  </time>
                </span>
              )}
            </div>
            <p class="project-description" data-pagefind-meta="description">
              {project.data.description}
            </p>

            <div class="project-info">
              {project.data.tags && (
                <div class="pill-list project-tags">
                  {project.data.tags.map((tag) => (
                    <span class="tag" data-pagefind-filter="tag">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="project-links">
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary"
                  >
                    ライブデモを見る
                  </a>
                )}
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-glass"
                  >
                    ソースコードを見る
                  </a>
                )}
              </div>
            </div>
          </div>

          {heroImage && (
            <BlogThumbnail
              src={heroImage}
              alt={project.data.title}
              tone="original"
              loading="eager"
              pagefindImage
              class="project-image"
            />
          )}
        </div>
      </div>
    </header>

    <div class="project-content">
      <div class="container">
        <div class="bento-panel content-wrapper card-glass" data-pagefind-body>
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .project-detail {
    padding-top: var(--space-xl);
  }

  .breadcrumb {
    margin-bottom: var(--space-lg);
  }

  .breadcrumb .btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
  }

  .project-hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    align-items: center;
    margin-bottom: var(--space-2xl);
  }

  .project-hero--single {
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
  }

  .project-hero--single .project-info {
    align-items: center;
  }

  .project-hero--single .project-tags {
    justify-content: center;
  }

  .project-hero--single .project-links {
    justify-content: center;
    flex-wrap: wrap;
  }

  .project-meta {
    min-width: 0;
    width: 100%;
  }

  .project-meta h1 {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .project-description {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project-date {
    font-family: var(--font-family-mono);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .updated {
    color: var(--text-accent);
  }

  .project-tags {
  }

  .tag {
    background: transparent;
    color: var(--text-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 400;
    border: 1px solid var(--border-editorial);
  }

  .project-links {
    flex-wrap: wrap;
    display: flex;
    gap: var(--space-md);
  }

  .project-image {
    width: 100%;
    --thumbnail-height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-editorial);
  }

  .project-content {
    padding: var(--space-2xl) 0;
  }

  .content-wrapper {
    min-width: 0;
    font-size: 1rem;
    overflow-wrap: anywhere;
    padding: var(--card-padding);
    border-radius: var(--radius-xl);
  }

  .content-wrapper :global(h1),
  .content-wrapper :global(h2),
  .content-wrapper :global(h3),
  .content-wrapper :global(h4),
  .content-wrapper :global(h5),
  .content-wrapper :global(h6) {
    color: var(--text-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    font-family: var(--font-family-japanese);
  }

  .content-wrapper :global(h1):first-child,
  .content-wrapper :global(h2):first-child,
  .content-wrapper :global(h3):first-child {
    margin-top: 0;
  }

  .content-wrapper :global(p) {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    line-height: 1.85;
  }

  .content-wrapper :global(ul),
  .content-wrapper :global(ol) {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .content-wrapper :global(li) {
    margin-bottom: var(--space-xs);
  }

  .content-wrapper :global(pre) {
    background: var(--bento-muted-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin: var(--space-lg) 0;
  }

  .content-wrapper :global(code) {
    font-family: var(--font-family-mono);
    font-size: 0.9em;
  }

  .content-wrapper :global(blockquote) {
    border-left: 1px solid var(--border-strong);
    padding-left: var(--space-md);
    margin: var(--space-lg) 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .content-wrapper :global(.table-scroll) {
    max-width: 100%;
    overflow-x: auto;
    margin: var(--space-lg) 0;
  }

  .content-wrapper :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .content-wrapper :global(img) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .project-hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .project-meta h1 {
      font-size: 2rem;
    }

    .project-links {
      justify-content: center;
      flex-wrap: wrap;
    }

    .content-wrapper {
      padding: var(--card-padding);
    }
  }
</style>
