---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const careerEntry = await getEntry('career', 'career');

if (!careerEntry) {
  throw new Error('Missing career content entry: src/content/pages/career.md');
}

const { timeline } = careerEntry.data;

const normalizeTech = (tech: string) => tech.replace(/^Java \d+$/, 'Java');

const timelineTechSet = new Set(
  timeline.flatMap((item) => item.techStack).map(normalizeTech)
);

const stackSources = [
  {
    label: 'Backend',
    items: ['Java', 'Quarkus', 'Spring', 'Ruby on Rails', 'Node.js', 'PHP'],
  },
  {
    label: 'Frontend',
    items: [
      'TypeScript',
      'React',
      'Nuxt.js',
      'Angular',
      'jQuery',
      'MUI',
      'Ant Design',
    ],
  },
  {
    label: 'Platform / Data',
    items: [
      'Azure',
      'Azure AI Search',
      'Azure OpenAI',
      'Azure Functions',
      'Docker',
      'PostgreSQL',
      'ArangoDB',
      'GitLab',
      'Jenkins',
      'ARO',
    ],
  },
];

const stackGroups = stackSources
  .map((group) => ({
    ...group,
    items: group.items.filter((item) => timelineTechSet.has(item)),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout title="Career - Portfolio">
  <section class="page-shell career-hero">
    <div class="container">
      <div class="career-overview-grid">
        <section
          class="bento-hero career-card career-card--hero hero-content card-glass"
        >
          <h1 class="screen-only">Career</h1>
          <p class="screen-only career-subtitle">A rough career history.</p>
          <h1 class="print-only print-hero-title">職務経歴書</h1>
        </section>

        <section
          class="bento-panel career-card career-card--experience card-glass screen-only"
        >
          <span class="experience-label">Production systems</span>
          <h2 aria-label="10+ years in production systems">
            <span class="metric-value">10+</span> years in production systems
          </h2>
        </section>

        <section
          class="bento-panel career-card career-card--stack card-glass screen-only"
        >
          <h2>Core Stack</h2>
          <div class="stack-matrix">
            {
              stackGroups.map((group) => (
                <div class="stack-column" aria-label={`${group.label} stack`}>
                  <span class="stack-label">{group.label}</span>
                  <div class="stack-list">
                    {group.items.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="career-content">
    <div class="container">
      <div class="timeline">
        {
          timeline.map((item, index) => (
            <div class="timeline-item">
              <div class:list={['timeline-marker', { current: index === 0 }]}>
                <div class="timeline-dot" />
              </div>
              <div class="bento-panel timeline-content card-glass">
                <div class="timeline-header">
                  <h3>{item.title}</h3>
                  <span class="timeline-period">{item.period}</span>
                  <span class="timeline-role">{item.role}</span>
                </div>
                <div class="timeline-body">
                  <p class="project-description">{item.description}</p>
                  <div class="project-details">
                    <div class="detail-item">
                      <strong>チーム規模:</strong> {item.teamSize}
                    </div>
                    <div class="detail-item">
                      <strong>主な業務:</strong> {item.responsibilities}
                    </div>
                    <div class="detail-item">
                      <strong>技術スタック:</strong>
                      <div class="pill-list tech-tags">
                        {item.techStack.map((tech) => (
                          <span class="tech-tag">{tech}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="skills-summary">
    <div class="container">
      <h2>保有資格</h2>
      <div class="bento-panel certifications card-glass">
        <div class="cert-item">
          <div class="cert-icon cert-icon--credential" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path
                d="M7 4.5h10v11H7v-11Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <path
                d="M9.75 8h4.5M9.75 11h3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
              <path
                d="m10 15.5-.75 4 2.75-1.35L14.75 19.5l-.75-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="cert-info">
            <h3>基本情報技術者試験</h3>
            <span class="cert-date">2014年取得</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .career-overview-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .career-card {
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .career-card--hero {
    grid-column: span 4;
    min-height: 220px;
    background: var(--bento-card-bg);
  }

  .career-card--experience {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .career-card--stack {
    grid-column: span 6;
    background: var(--bento-card-bg);
  }

  .hero-content {
    min-height: 220px;
  }

  .career-card h1 {
    max-width: 820px;
    font-size: clamp(2.75rem, 7vw, 5rem);
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .career-subtitle {
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 600;
    margin: 0;
    opacity: 0.72;
  }

  .career-card h2 {
    color: var(--text-primary);
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-2xl);
  }

  .career-card p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  .experience-label {
    color: var(--text-primary);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .metric-value {
    display: block;
    color: var(--text-primary);
    font-size: clamp(4rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .stack-matrix {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 8px;
    overflow: hidden;
  }

  .stack-column {
    min-width: 0;
    padding: var(--space-md);
    border-left: 1px solid rgba(15, 23, 42, 0.08);
  }

  .stack-column:first-child {
    border-left: 0;
  }

  .stack-label {
    display: block;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .stack-list span {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--text-primary);
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: var(--space-xs) var(--space-sm);
  }

  .print-only {
    display: none;
  }

  .career-content {
    padding: var(--space-md) 0 var(--space-2xl);
  }

  .timeline {
    --timeline-line-x: 30px;
    --timeline-dot-size: 20px;

    position: relative;
    max-width: 920px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--timeline-line-x);
    width: 2px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(148, 163, 184, 0) 0%,
      var(--glass-border) 2%,
      var(--glass-border) 98%,
      rgba(148, 163, 184, 0) 100%
    );
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-2xl);
    padding-left: calc(
      var(--timeline-line-x) + var(--timeline-dot-size) + var(--space-sm)
    );
  }

  .timeline-marker {
    position: absolute;
    left: calc(var(--timeline-line-x) - var(--timeline-dot-size) / 2);
    top: 50%;
    width: var(--timeline-dot-size);
    height: var(--timeline-dot-size);
    transform: translateY(-50%);
  }

  .timeline-dot {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--timeline-dot-bg);
    border: 3px solid var(--timeline-dot-border);
    position: relative;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.55),
      0 8px 16px -10px rgba(59, 130, 246, 0.22);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .timeline-marker.current .timeline-dot {
    background: var(--timeline-dot-active);
    border-color: var(--text-accent);
    box-shadow:
      0 0 0 6px rgba(59, 130, 246, 0.18),
      0 20px 36px -18px var(--timeline-dot-glow);
    transform: scale(1.05);
  }

  .timeline-content {
  }

  .timeline-header {
    margin-bottom: var(--space-md);
  }

  .timeline-header h3 {
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-xl);
  }

  .timeline-period {
    display: inline-block;
    background: var(--bento-muted-bg);
    color: var(--text-accent);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-right: var(--space-sm);
  }

  .timeline-role {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .project-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .detail-item {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  .detail-item strong {
    color: var(--text-primary);
  }

  .tech-tags {
    margin-top: var(--space-xs);
  }

  .tech-tag {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .skills-summary {
    padding: 0 0 var(--space-2xl);
  }

  .skills-summary h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
    font-size: var(--font-size-3xl);
    color: var(--text-primary);
  }

  .certifications {
    max-width: 600px;
    margin: 0 auto;
    border-radius: var(--radius-xl);
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .cert-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bento-muted-bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
  }

  .cert-icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .cert-info h3 {
    color: var(--text-primary);
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--font-size-lg);
  }

  .cert-date {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 900px) {
    .career-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .career-card {
      grid-column: span 2;
    }

    .stack-matrix {
      grid-template-columns: 1fr;
    }

    .stack-column {
      border-left: 0;
      border-top: 1px solid rgba(15, 23, 42, 0.08);
    }

    .stack-column:first-child {
      border-top: 0;
    }
  }

  @media (max-width: 768px) {
    .timeline {
      --timeline-line-x: 18px;
      --timeline-dot-size: 18px;
      --timeline-card-offset: 44px;
    }

    .hero-content h1 {
      font-size: var(--font-size-4xl);
    }

    .timeline-item {
      padding-left: var(--timeline-card-offset);
      margin-bottom: var(--space-xl);
    }

    .timeline-marker {
      top: 30px;
    }

    .timeline-content {
      padding: var(--space-md);
    }

    .tech-tags {
      justify-content: flex-start;
    }

    .timeline-period {
      display: block;
      margin-bottom: var(--space-xs);
    }
  }

  /* 印刷用スタイル */
  @media print {
    /* 基本設定 */
    * {
      -webkit-print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    body {
      font-size: 12pt;
      line-height: 1.4;
      color: #000 !important;
      background: white !important;
    }

    .screen-only {
      display: none !important;
    }

    .print-only {
      display: block !important;
    }

    /* ナビゲーション・フッターを非表示 */
    .navbar,
    .footer {
      display: none !important;
    }

    /* ヒーローセクションを簡素化 */
    .career-hero {
      padding: 20pt 0 10pt;
      page-break-after: avoid;
    }

    .hero-content h1 {
      font-size: 18pt;
      color: #000 !important;
      background: none !important;
      -webkit-text-fill-color: initial !important;
      margin-bottom: 10pt;
    }

    .print-hero-title {
      text-align: center;
    }

    .hero-content p {
      font-size: 11pt;
      color: #333 !important;
      margin-bottom: 15pt;
    }

    /* タイムライン調整 */
    .career-content {
      padding: 0;
    }

    .timeline {
      max-width: 100%;
      margin: 0;
    }

    .timeline::before {
      display: none !important;
    }

    .timeline-item {
      padding-left: 0 !important;
      margin-bottom: 15pt;
      page-break-inside: avoid;
    }

    .timeline-marker {
      display: none !important;
    }

    .timeline-dot {
      display: none !important;
    }

    /* タイムラインコンテンツ */
    .timeline-content {
      background: white !important;
      backdrop-filter: none !important;
      border: 1pt solid #ddd !important;
      box-shadow: none !important;
      padding: 12pt;
      border-radius: 3pt;
    }

    .timeline-header {
      margin-bottom: 8pt;
    }

    .timeline-header h3 {
      font-size: 14pt;
      color: #000 !important;
      margin-bottom: 4pt;
      font-weight: bold;
    }

    .timeline-period {
      background: #f0f0f0 !important;
      color: #000 !important;
      padding: 2pt 6pt;
      border-radius: 2pt;
      font-size: 9pt;
      font-weight: normal;
      margin-right: 8pt;
      border: 1pt solid #ccc;
    }

    .timeline-role {
      color: #555 !important;
      font-size: 10pt;
    }

    .project-description {
      color: #444 !important;
      font-size: 11pt;
      margin-bottom: 8pt;
      font-style: normal;
    }

    .detail-item {
      color: #333 !important;
      font-size: 10pt;
      margin-bottom: 4pt;
    }

    .detail-item strong {
      color: #000 !important;
      font-weight: bold;
    }

    /* 技術タグ */
    .tech-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 3pt;
      margin-top: 4pt;
    }

    .tech-tag {
      background: #f5f5f5 !important;
      color: #333 !important;
      padding: 2pt 4pt;
      border-radius: 2pt;
      font-size: 8pt;
      border: 1pt solid #ddd !important;
      font-weight: normal;
    }

    /* 資格セクション */
    .skills-summary {
      padding: 15pt 0 0;
      page-break-before: auto;
    }

    .skills-summary h2 {
      font-size: 16pt;
      color: #000 !important;
      margin-bottom: 10pt;
      font-weight: bold;
    }

    .certifications {
      background: white !important;
      border: 1pt solid #ddd !important;
      box-shadow: none !important;
      padding: 12pt;
      border-radius: 3pt;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .cert-item {
      gap: 8pt;
    }

    .cert-icon {
      background: #f0f0f0 !important;
      border: 1pt solid #ccc !important;
      width: 30pt;
      height: 30pt;
      font-size: 14pt;
    }

    .cert-info h3 {
      color: #000 !important;
      font-size: 12pt;
      font-weight: bold;
    }

    .cert-date {
      color: #555 !important;
      font-size: 10pt;
    }

    /* ページ区切り調整 */
    .timeline-item:nth-child(6n) {
      page-break-after: auto;
    }

    /* 印刷時の余白調整 */
    @page {
      margin: 15mm;
      size: A4;
    }
  }
</style>
