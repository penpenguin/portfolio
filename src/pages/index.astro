---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
---

<Layout title="Portfolio - Programmer">
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid">
        <section
          class="bento-hero bento-panel bento-card bento-card--intro card-glass"
        >
          <p class="bento-eyebrow eyebrow">Enterprise Systems Programmer</p>
          <h1>Hello, I'm a Programmer</h1>
          <p class="lead">
            メーカーの社内システム構築支援を中心に、Web技術からバックエンド、インフラまで幅広く対応。
            10年以上の経験を活かし、要件定義から運用まで一貫したシステム開発をサポートします。
          </p>
          <div class="action-row">
            <Link href="/career" class="btn btn-primary">プロジェクト実績</Link>
            <Link href="/contact" class="btn btn-glass">お問い合わせ</Link>
          </div>
        </section>

        <section class="bento-panel bento-card bento-card--metric card-glass">
          <span class="metric-value">10+</span>
          <p class="metric-label">years</p>
          <p>要件定義から運用まで、長期運用される業務システムを支援。</p>
        </section>

        <section class="bento-panel bento-card bento-card--stack card-glass">
          <p class="bento-eyebrow eyebrow">Core Stack</p>
          <div class="pill-list stack-list">
            <span>Java</span>
            <span>TypeScript</span>
            <span>React</span>
            <span>Azure</span>
            <span>Quarkus</span>
            <span>GitLab CI/CD</span>
          </div>
        </section>

        <section class="bento-panel bento-card bento-card--feature card-glass">
          <span class="bento-eyebrow tile-number">01</span>
          <h3>社内システム開発</h3>
          <p>
            メーカーの業務システム構築支援を中心に、要件定義から運用まで一貫したサポートを提供します。
          </p>
        </section>

        <section class="bento-panel bento-card bento-card--feature card-glass">
          <span class="bento-eyebrow tile-number">02</span>
          <h3>フルスタック開発</h3>
          <p>
            フロントエンド（React/TypeScript）からバックエンド（Java/Node.js）、インフラ（Azure）まで対応。
          </p>
        </section>

        <section class="bento-panel bento-card bento-card--feature card-glass">
          <span class="bento-eyebrow tile-number">03</span>
          <h3>CI/CD・自動化</h3>
          <p>
            GitLab
            CI/CDを活用したテスト自動化、デプロイ自動化によって開発効率を向上させます。
          </p>
        </section>

        <section class="bento-panel bento-card bento-card--wide card-glass">
          <p class="bento-eyebrow eyebrow">Current Focus</p>
          <h2>業務知識と実装力の間を埋める設計</h2>
          <p>
            複雑な業務要件を、保守しやすいWebシステムと運用可能な開発プロセスへ落とし込みます。
          </p>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bento-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card {
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: 430px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.96),
        rgba(238, 242, 255, 0.9)
      ),
      var(--bento-card-bg);
  }

  .bento-card--metric {
    grid-column: span 1;
    background: var(--text-primary);
    color: #ffffff;
  }

  .bento-card--metric p {
    color: rgba(255, 255, 255, 0.78);
  }

  .bento-card--stack,
  .bento-card--wide {
    grid-column: span 2;
  }

  .bento-card--feature {
    grid-column: span 1;
  }

  .bento-card h1 {
    max-width: 760px;
    margin: var(--space-sm) 0;
    font-size: clamp(2.5rem, 7vw, 5.75rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .bento-card h2,
  .bento-card h3 {
    margin: 0 0 var(--space-sm) 0;
  }

  .lead {
    max-width: 720px;
    font-size: var(--font-size-lg);
  }

  .eyebrow,
  .tile-number,
  .metric-label {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .action-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .metric-value {
    display: block;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .stack-list span {
    color: var(--text-primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .tile-number {
    display: block;
    margin-bottom: var(--space-xl);
  }

  .bento-card p {
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--intro,
    .bento-card--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .bento-card,
    .bento-card--intro,
    .bento-card--metric,
    .bento-card--stack,
    .bento-card--feature,
    .bento-card--wide {
      grid-column: span 1;
      min-height: auto;
    }

    .bento-card h1 {
      font-size: var(--font-size-5xl);
    }
  }

  @media (max-width: 420px) {
    .bento-card h1 {
      font-size: var(--font-size-4xl);
    }
  }
</style>
