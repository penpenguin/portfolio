---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';
import { sortPublishedPostsByDate } from '../utils/blog';

const projects = await getCollection('projects');
const [latestProject] = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const blogPosts = await getCollection('blog');
const [latestPost] = sortPublishedPostsByDate(blogPosts);

const overviewCards = [
  {
    eyebrow: 'About',
    title: 'どんな人か',
    description:
      '業務システム開発で扱っている領域、役割、技術スタックをまとめています。',
    href: '/about',
    meta: 'プロフィールと得意領域',
  },
  {
    eyebrow: 'Career',
    title: 'どんな経歴か',
    description:
      'これまで関わってきた業務システム開発、担当領域、技術スタックを時系列で確認できます。',
    href: '/career',
    meta: '経歴と担当プロジェクト',
  },
];
---

<Layout
  title="Portfolio - Programmer"
  description="プロフィール、制作物、技術メモ、職務経歴、連絡先をまとめたポートフォリオです。"
>
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid home-overview-grid">
        <section
          class="bento-hero bento-panel bento-card bento-card--intro card-glass"
        >
          <div class="intro-copy">
            <p class="bento-eyebrow eyebrow">Enterprise Systems Programmer</p>
            <h1>Enterprise systems, shipped end-to-end</h1>
          </div>
        </section>

        <section class="bento-panel bento-card bento-card--metric card-glass">
          <span class="metric-value">10+</span>
          <p class="metric-label">years in production systems</p>
          <p>要件定義から運用改善まで、長期運用される業務システムを支援。</p>
        </section>

        {
          latestProject && (
            <section class="bento-panel bento-card bento-card--project card-glass">
              <p class="bento-eyebrow eyebrow">Featured Project</p>
              <div class="project-summary">
                <span class="project-kicker">
                  {formatDate(latestProject.data.pubDate)}
                </span>
                <h2>
                  <Link href={`/projects/${latestProject.id}`}>
                    {latestProject.data.title}
                  </Link>
                </h2>
                <p>{latestProject.data.description}</p>
              </div>
              {latestProject.data.tags && (
                <div class="pill-list project-tags">
                  {latestProject.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/projects" class="overview-link project-index-link">
                Projects一覧を見る
              </Link>
            </section>
          )
        }

        {
          overviewCards.map((card) => (
            <article class="bento-panel overview-card card-glass">
              <div>
                <p class="bento-eyebrow eyebrow">{card.eyebrow}</p>
                <h2>{card.title}</h2>
                <p>{card.description}</p>
              </div>
              <div class="overview-card__footer">
                <span>{card.meta}</span>
                <Link href={card.href} class="overview-link">
                  ページを見る
                </Link>
              </div>
            </article>
          ))
        }

        {
          latestPost && (
            <section class="bento-panel bento-card bento-card--blog card-glass">
              <p class="bento-eyebrow eyebrow">Featured Article</p>
              <div class="blog-summary">
                <span class="blog-kicker">
                  {formatDate(latestPost.data.pubDate)}
                </span>
                <h2>
                  <Link href={`/blog/${latestPost.id}`}>
                    {latestPost.data.title}
                  </Link>
                </h2>
                <p>{latestPost.data.description}</p>
              </div>
              {latestPost.data.tags && (
                <div class="pill-list blog-tags">
                  {latestPost.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/blog" class="overview-link project-index-link">
                Blog一覧を見る
              </Link>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-overview-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card,
  .overview-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: 390px;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.96),
        rgba(238, 242, 255, 0.72) 58%,
        rgba(236, 254, 255, 0.7)
      ),
      var(--bento-card-bg);
  }

  .bento-card--metric {
    grid-column: span 1;
    background: var(--text-primary);
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .bento-card--metric::after {
    content: '';
    position: absolute;
    right: -32px;
    bottom: -32px;
    width: 132px;
    height: 132px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
  }

  .bento-card--metric p {
    color: rgba(255, 255, 255, 0.78);
  }

  .bento-card--project {
    grid-column: span 2;
    background:
      linear-gradient(135deg, rgba(236, 254, 255, 0.78), transparent 62%),
      var(--bento-card-bg);
  }

  .bento-card--blog {
    grid-column: span 2;
    background:
      linear-gradient(135deg, rgba(240, 253, 244, 0.78), transparent 62%),
      var(--bento-card-bg);
  }

  .bento-card h1,
  .overview-card h1 {
    max-width: 760px;
    margin: var(--space-sm) 0;
    font-size: 5.25rem;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .overview-card h2 {
    margin: 0 0 var(--space-sm) 0;
    color: var(--text-primary);
    font-size: var(--font-size-3xl);
  }

  .project-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .blog-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .project-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .blog-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .project-summary h2 a {
    color: var(--text-primary);
  }

  .blog-summary h2 a {
    color: var(--text-primary);
  }

  .project-kicker {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .blog-kicker {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .project-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .blog-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .metric-label {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .metric-value {
    display: block;
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .intro-copy {
    max-width: 820px;
  }

  .eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .bento-card p,
  .overview-card p {
    margin-bottom: 0;
  }

  .project-index-link {
    align-self: flex-start;
    margin-top: var(--space-lg);
  }

  .overview-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .overview-card__footer span {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .overview-link {
    color: var(--text-accent);
    flex: 0 0 auto;
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .overview-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 980px) {
    .home-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--intro,
    .bento-card--project,
    .bento-card--blog {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .home-overview-grid {
      grid-template-columns: 1fr;
    }

    .bento-card,
    .bento-card--intro,
    .bento-card--metric,
    .bento-card--project,
    .bento-card--blog,
    .overview-card {
      grid-column: span 1;
      min-height: auto;
    }

    .bento-card h1,
    .overview-card h1 {
      font-size: 3rem;
      line-height: 1.02;
    }

    .overview-card__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-sm);
    }
  }

  @media (max-width: 420px) {
    .bento-card h1,
    .overview-card h1 {
      font-size: 2.5rem;
    }
  }
</style>
