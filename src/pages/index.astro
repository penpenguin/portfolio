---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import WireframeDevice from '../components/WireframeDevice.astro';
import { formatDate } from '../utils/formatDate';
import { sortPublishedPostsByDate } from '../utils/blog';

const projects = await getCollection('projects');
const [latestProject] = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const blogPosts = await getCollection('blog');
const [latestPost] = sortPublishedPostsByDate(blogPosts);
---

<Layout
  title="Portfolio - Programmer"
  description="プロフィール、制作物、技術メモ、連絡先をまとめたポートフォリオです。"
>
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid home-overview-grid">
        <section class="bento-hero bento-panel bento-card bento-card--intro card-glass">
          <div class="intro-copy">
            <h1>About</h1>
            <p class="intro-role">
              Memos on systems, tools, and everyday experiments.
            </p>
          </div>
        </section>

        <section
          class="bento-panel bento-card bento-card--device card-glass"
          aria-label="線画の3D装置"
        >
          <WireframeDevice />
        </section>

        {latestProject && (
          <section class="bento-panel bento-card bento-card--project card-glass">
            <div class="project-summary">
              <h2>
                <Link href={`/projects/${latestProject.id}`}>
                  {latestProject.data.title}
                </Link>
              </h2>
              <time
                class="project-card-meta"
                datetime={latestProject.data.pubDate.toISOString()}
              >
                {formatDate(latestProject.data.pubDate)}
              </time>
              <p>{latestProject.data.description}</p>
            </div>
            {latestProject.data.tags && (
              <div class="pill-list project-tags">
                {latestProject.data.tags.slice(0, 4).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            )}
            <Link href="/projects" class="overview-link project-index-link">
              Projects一覧を見る
            </Link>
          </section>
        )}

        {latestPost && (
          <section class="bento-panel bento-card bento-card--blog card-glass">
            <div class="blog-summary">
              <h2>
                <Link href={`/blog/${latestPost.id}`}>
                  {latestPost.data.title}
                </Link>
              </h2>
              <time
                class="blog-card-meta"
                datetime={latestPost.data.pubDate.toISOString()}
              >
                {formatDate(latestPost.data.pubDate)}
              </time>
              <p>{latestPost.data.description}</p>
            </div>
            {latestPost.data.tags && (
              <div class="pill-list blog-tags">
                {latestPost.data.tags.slice(0, 4).map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            )}
            <Link href="/blog" class="overview-link project-index-link">
              Blog一覧を見る
            </Link>
          </section>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-overview-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: auto;
    background: var(--about-bg);
    border-color: var(--about-border);
  }

  .bento-card--intro:hover,
  .bento-card--intro:focus-within {
    background: var(--about-bg);
    border-color: var(--about-border);
  }

  .bento-card--device {
    grid-column: span 1;
    min-height: auto;
    padding: 0;
    background: var(--bento-muted-bg);
    position: relative;
    overflow: hidden;
  }

  .bento-card--project {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--blog {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(5.5rem, 7.2vw, 6.5rem);
    line-height: 1.02;
    font-weight: 400;
    color: var(--about-heading);
    letter-spacing: -0.025em;
  }

  .project-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .blog-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .project-summary h2 {
    margin-bottom: 0;
    font-size: 1.875rem;
    line-height: 1.35;
  }

  .blog-summary h2 {
    margin-bottom: 0;
    font-family: var(--font-family-japanese);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .project-summary h2 a {
    color: var(--text-primary);
  }

  .blog-summary h2 a {
    color: var(--text-primary);
  }

  .project-card-meta {
    font-family: var(--font-family-mono);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .blog-card-meta {
    font-family: var(--font-family-mono);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .project-tags span {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }

  .blog-tags span {
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 400;
  }

  .intro-copy {
    max-width: 820px;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }

  .intro-role {
    margin: 0;
    color: var(--about-text);
    font-size: var(--font-size-base);
  }

  .bento-card p {
    margin-bottom: 0;
  }

  .project-index-link {
    align-self: flex-start;
    margin-top: auto;
  }

  .overview-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    color: var(--text-secondary);
    flex: 0 0 auto;
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .overview-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 980px) {
    .home-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--intro,
    .bento-card--device,
    .bento-card--project,
    .bento-card--blog {
      grid-column: span 2;
    }

    .bento-card--device {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .home-overview-grid {
      grid-template-columns: 1fr;
    }

    .bento-card,
    .bento-card--intro,
    .bento-card--device,
    .bento-card--project,
    .bento-card--blog {
      grid-column: span 1;
      min-height: auto;
    }

    .bento-card h1 {
      font-size: clamp(4rem, 18vw, 5rem);
      line-height: 1.02;
    }
  }

  @media (max-width: 768px) {
    .intro-copy {
      gap: 2rem;
    }
    .project-summary h2 {
      font-size: 1.625rem;
    }
    .blog-summary h2 {
      font-size: 1.375rem;
    }
  }
</style>
