---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';
import { sortPublishedPostsByDate } from '../utils/blog';
import { withBase } from '../utils/withBase';

const projects = await getCollection('projects');
const [latestProject] = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const blogPosts = await getCollection('blog');
const [latestPost] = sortPublishedPostsByDate(blogPosts);

const playground = {
  previewImage: '/assets/home/meaningless-night-window.webp',
};
---

<Layout
  title="Portfolio - Programmer"
  description="プロフィール、制作物、技術メモ、連絡先をまとめたポートフォリオです。"
>
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid home-overview-grid">
        <section
          class="bento-hero bento-panel bento-card bento-card--intro card-glass"
        >
          <div class="intro-copy">
            <h1>About</h1>
            <p class="intro-role">
              Memos on systems, tools, and everyday experiments.
            </p>
          </div>
        </section>

        <section class="bento-panel bento-card bento-card--metric card-glass">
          <span class="metric-value">10+</span>
          <p class="metric-label">years building systems</p>
        </section>

        {
          latestProject && (
            <section class="bento-panel bento-card bento-card--project card-glass">
              <div class="project-summary">
                <h2>
                  <Link href={`/projects/${latestProject.id}`}>
                    {latestProject.data.title}
                  </Link>
                </h2>
                <span class="project-card-meta">
                  {formatDate(latestProject.data.pubDate)}
                </span>
                <p>{latestProject.data.description}</p>
              </div>
              {latestProject.data.tags && (
                <div class="pill-list project-tags">
                  {latestProject.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/projects" class="overview-link project-index-link">
                Projects一覧を見る
              </Link>
            </section>
          )
        }

        {
          latestPost && (
            <section class="bento-panel bento-card bento-card--blog card-glass">
              <div class="blog-summary">
                <h2>
                  <Link href={`/blog/${latestPost.id}`}>
                    {latestPost.data.title}
                  </Link>
                </h2>
                <span class="blog-card-meta">
                  {formatDate(latestPost.data.pubDate)}
                </span>
                <p>{latestPost.data.description}</p>
              </div>
              {latestPost.data.tags && (
                <div class="pill-list blog-tags">
                  {latestPost.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/blog" class="overview-link project-index-link">
                Blog一覧を見る
              </Link>
            </section>
          )
        }

        <section
          class="bento-panel bento-card bento-card--playground card-glass"
          aria-label="Meaningless window scene"
        >
          <div class="window-scene">
            <img
              class="window-scene__image"
              src={withBase(playground.previewImage)}
              alt="Window view of Meaningless at night"
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
            <span class="window-scene__skyline-glow" aria-hidden="true"></span>
            <span class="window-scene__city-lights" aria-hidden="true"></span>
            <span class="window-scene__aircraft-beacons" aria-hidden="true"
            ></span>
            <span class="window-scene__road-lights" aria-hidden="true"></span>
            <span class="window-scene__tail-lamps" aria-hidden="true">
              <span
                class="window-scene__tail-lamps-track window-scene__tail-lamps-track--near"
              ></span>
              <span
                class="window-scene__tail-lamps-track window-scene__tail-lamps-track--bend"
              ></span>
              <span
                class="window-scene__tail-lamps-track window-scene__tail-lamps-track--far"
              ></span>
            </span>
            <span class="window-scene__tree-line" aria-hidden="true"></span>
            <span class="window-scene__mullion" aria-hidden="true"></span>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-overview-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: auto;
    background: var(--bento-card-bg);
  }

  .bento-card--metric {
    grid-column: span 1;
    min-height: auto;
    background: var(--text-primary);
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .bento-card--metric::after {
    content: '';
    position: absolute;
    right: -32px;
    bottom: -32px;
    width: 132px;
    height: 132px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
  }

  .bento-card--metric p {
    color: rgba(255, 255, 255, 0.78);
  }

  .bento-card--project {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--blog {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--playground {
    grid-column: span 2;
    gap: 0;
    justify-content: center;
    background: var(--bento-card-bg);
  }

  .bento-card h1 {
    max-width: 760px;
    margin: var(--space-sm) 0;
    font-size: 5.25rem;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .project-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .blog-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .project-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .blog-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .project-summary h2 a {
    color: var(--text-primary);
  }

  .blog-summary h2 a {
    color: var(--text-primary);
  }

  .project-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .blog-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .project-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .blog-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .metric-label {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .metric-value {
    display: block;
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .intro-copy {
    max-width: 820px;
  }

  .intro-role {
    margin: var(--space-md) 0 0;
    color: var(--text-secondary);
    font-size: var(--font-size-lg);
  }

  .bento-card p {
    margin-bottom: 0;
  }

  .project-index-link {
    align-self: flex-start;
    margin-top: var(--space-lg);
  }

  .window-scene {
    aspect-ratio: 16 / 10;
    background: #08111a;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius-md);
    isolation: isolate;
    overflow: hidden;
    position: relative;
  }

  .window-scene::before {
    animation: glass-reflection 18s ease-in-out infinite;
    background:
      linear-gradient(
        112deg,
        transparent 0 34%,
        rgba(255, 255, 255, 0.1) 42%,
        transparent 50% 100%
      ),
      linear-gradient(
        76deg,
        transparent 0 58%,
        rgba(198, 226, 255, 0.08) 62%,
        transparent 68%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.12), transparent 24%);
    content: '';
    inset: -6%;
    opacity: 0.36;
    pointer-events: none;
    position: absolute;
    transform: translate3d(-6%, 0, 0);
    z-index: 3;
  }

  .window-scene::after {
    animation: night-vignette 16s ease-in-out infinite;
    background:
      radial-gradient(
        ellipse at 66% 56%,
        rgba(86, 145, 214, 0.16),
        transparent 34%
      ),
      radial-gradient(
        ellipse at 50% 54%,
        transparent 58%,
        rgba(2, 7, 13, 0.42) 100%
      ),
      linear-gradient(180deg, transparent 52%, rgba(4, 8, 13, 0.62));
    content: '';
    inset: 0;
    opacity: 0.78;
    pointer-events: none;
    position: absolute;
    z-index: 4;
  }

  .window-scene__image {
    animation: city-pan 38s ease-in-out infinite;
    display: block;
    height: 100%;
    object-fit: cover;
    transform: scale(1.055) translate3d(-0.7%, 0, 0);
    width: 100%;
  }

  .window-scene__skyline-glow {
    animation: city-bloom 11.5s ease-in-out infinite;
    background: radial-gradient(
      ellipse at 62% 56%,
      rgba(177, 211, 255, 0.3),
      transparent 44%
    );
    inset: 0;
    mix-blend-mode: screen;
    opacity: 0.3;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .window-scene__city-lights {
    animation: lights-glimmer 6.4s ease-in-out infinite;
    background:
      radial-gradient(
        circle at 55% 54%,
        rgba(255, 231, 182, 0.44) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 58% 49%,
        rgba(196, 224, 255, 0.4) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 61% 47%,
        rgba(255, 213, 151, 0.52) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 64% 55%,
        rgba(210, 230, 255, 0.38) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 69% 48%,
        rgba(255, 232, 188, 0.48) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 72% 51%,
        rgba(205, 226, 255, 0.48) 0 1px,
        transparent 2px
      ),
      radial-gradient(
        circle at 76% 57%,
        rgba(255, 223, 172, 0.4) 0 1px,
        transparent 2px
      );
    filter: blur(0.2px);
    inset: 0;
    mix-blend-mode: screen;
    opacity: 0.54;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .window-scene__aircraft-beacons {
    animation: beacon-blink 2.8s steps(1, end) infinite;
    background:
      radial-gradient(
        circle at 60.5% 43%,
        rgba(255, 42, 42, 0.95) 0 1px,
        rgba(255, 42, 42, 0.3) 2px,
        transparent 4px
      ),
      radial-gradient(
        circle at 65.3% 47%,
        rgba(255, 42, 42, 0.82) 0 1px,
        rgba(255, 42, 42, 0.26) 2px,
        transparent 4px
      );
    filter: drop-shadow(0 0 4px rgba(255, 42, 42, 0.48));
    inset: 0;
    mix-blend-mode: screen;
    opacity: 0.18;
    pointer-events: none;
    position: absolute;
    z-index: 3;
  }

  .window-scene__aircraft-beacons::after {
    animation: beacon-blink 3.4s steps(1, end) infinite;
    background:
      radial-gradient(
        circle at 70.8% 48%,
        rgba(255, 42, 42, 0.84) 0 1px,
        rgba(255, 42, 42, 0.26) 2px,
        transparent 4px
      ),
      radial-gradient(
        circle at 75.2% 52%,
        rgba(255, 42, 42, 0.76) 0 1px,
        rgba(255, 42, 42, 0.22) 2px,
        transparent 4px
      );
    content: '';
    filter: drop-shadow(0 0 3px rgba(255, 42, 42, 0.42));
    inset: 0;
    opacity: 0.3;
    pointer-events: none;
    position: absolute;
  }

  .window-scene__road-lights {
    animation: road-lights 7.6s ease-in-out infinite;
    background: linear-gradient(
      90deg,
      transparent 0 10%,
      rgba(255, 232, 190, 0.08) 24% 72%,
      transparent 88% 100%
    );
    bottom: 16%;
    height: 14%;
    left: 29%;
    opacity: 0.34;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    transform: rotate(-10deg) skewX(-24deg);
    transform-origin: 12% 60%;
    width: 74%;
    z-index: 2;
  }

  .window-scene__road-lights::before,
  .window-scene__road-lights::after {
    content: '';
    filter: blur(1px);
    height: 4px;
    left: -38%;
    opacity: 0.56;
    position: absolute;
    width: 142%;
  }

  .window-scene__road-lights::before {
    animation: road-headlights 4.2s linear infinite;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 12%,
      rgba(255, 236, 196, 0.9) 13.2% 15.4%,
      rgba(255, 255, 244, 0.7) 16% 17.2%,
      transparent 18% 30%
    );
    top: 34%;
  }

  .window-scene__road-lights::after {
    animation: road-tail-lights 4.8s linear infinite;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 15%,
      rgba(255, 86, 65, 0.42) 16.2% 18%,
      rgba(255, 142, 94, 0.28) 18.6% 19.8%,
      transparent 20.5% 34%
    );
    top: 55%;
  }

  .window-scene__tail-lamps {
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 3;
  }

  .window-scene__tail-lamps-track {
    mix-blend-mode: screen;
    pointer-events: none;
    position: absolute;
    transform-origin: 12% 60%;
  }

  .window-scene__tail-lamps-track--near {
    animation: tail-lamps-near-flow 7.4s linear infinite;
    background:
      radial-gradient(
        circle at 10% 58%,
        rgba(255, 52, 52, 0.58) 0 1.1px,
        rgba(255, 52, 52, 0.18) 2px,
        transparent 3.4px
      ),
      radial-gradient(
        circle at 11.8% 58%,
        rgba(255, 52, 52, 0.58) 0 1.1px,
        rgba(255, 52, 52, 0.18) 2px,
        transparent 3.4px
      ),
      radial-gradient(
        circle at 36% 52%,
        rgba(255, 52, 52, 0.5) 0 0.95px,
        rgba(255, 52, 52, 0.16) 1.8px,
        transparent 3.1px
      ),
      radial-gradient(
        circle at 37.6% 52%,
        rgba(255, 52, 52, 0.5) 0 0.95px,
        rgba(255, 52, 52, 0.16) 1.8px,
        transparent 3.1px
      ),
      radial-gradient(
        circle at 64% 46%,
        rgba(255, 52, 52, 0.42) 0 0.8px,
        rgba(255, 52, 52, 0.13) 1.6px,
        transparent 2.8px
      ),
      radial-gradient(
        circle at 65.4% 46%,
        rgba(255, 52, 52, 0.42) 0 0.8px,
        rgba(255, 52, 52, 0.13) 1.6px,
        transparent 2.8px
      );
    bottom: 15.6%;
    filter: blur(0.1px) drop-shadow(0 0 2px rgba(255, 52, 52, 0.22));
    height: 8%;
    left: 31%;
    opacity: 0.56;
    transform: rotate(-8deg) skewX(-16deg);
    width: 48%;
  }

  .window-scene__tail-lamps-track--bend {
    animation: tail-lamps-bend-flow 8.8s linear infinite;
    background:
      radial-gradient(
        circle at 18% 58%,
        rgba(255, 52, 52, 0.46) 0 0.85px,
        rgba(255, 52, 52, 0.14) 1.6px,
        transparent 2.8px
      ),
      radial-gradient(
        circle at 19.5% 58%,
        rgba(255, 52, 52, 0.46) 0 0.85px,
        rgba(255, 52, 52, 0.14) 1.6px,
        transparent 2.8px
      ),
      radial-gradient(
        circle at 48% 45%,
        rgba(255, 52, 52, 0.38) 0 0.72px,
        rgba(255, 52, 52, 0.12) 1.4px,
        transparent 2.4px
      ),
      radial-gradient(
        circle at 49.3% 45%,
        rgba(255, 52, 52, 0.38) 0 0.72px,
        rgba(255, 52, 52, 0.12) 1.4px,
        transparent 2.4px
      );
    bottom: 18.2%;
    filter: blur(0.08px) drop-shadow(0 0 1.8px rgba(255, 52, 52, 0.18));
    height: 7%;
    left: 49%;
    opacity: 0.44;
    transform: rotate(-18deg) skewX(-18deg);
    width: 25%;
  }

  .window-scene__tail-lamps-track--far {
    animation: tail-lamps-far-flow 10.2s linear infinite;
    background:
      radial-gradient(
        circle at 22% 58%,
        rgba(255, 52, 52, 0.32) 0 0.65px,
        rgba(255, 52, 52, 0.1) 1.2px,
        transparent 2.1px
      ),
      radial-gradient(
        circle at 23.2% 58%,
        rgba(255, 52, 52, 0.32) 0 0.65px,
        rgba(255, 52, 52, 0.1) 1.2px,
        transparent 2.1px
      ),
      radial-gradient(
        circle at 60% 48%,
        rgba(255, 52, 52, 0.26) 0 0.55px,
        rgba(255, 52, 52, 0.08) 1.1px,
        transparent 1.9px
      ),
      radial-gradient(
        circle at 61% 48%,
        rgba(255, 52, 52, 0.26) 0 0.55px,
        rgba(255, 52, 52, 0.08) 1.1px,
        transparent 1.9px
      );
    bottom: 21%;
    filter: blur(0.06px) drop-shadow(0 0 1.4px rgba(255, 52, 52, 0.14));
    height: 5%;
    left: 63%;
    opacity: 0.34;
    transform: rotate(-3deg) skewX(-8deg);
    width: 28%;
  }

  .window-scene__tree-line {
    animation: trees-breathe 10.5s ease-in-out infinite;
    background:
      radial-gradient(
        circle at 12% 64%,
        rgba(25, 56, 39, 0.82),
        transparent 20%
      ),
      radial-gradient(
        circle at 32% 76%,
        rgba(20, 48, 34, 0.8),
        transparent 21%
      ),
      radial-gradient(
        circle at 70% 68%,
        rgba(29, 63, 43, 0.82),
        transparent 22%
      ),
      radial-gradient(
        circle at 88% 56%,
        rgba(19, 44, 33, 0.86),
        transparent 23%
      );
    bottom: -9%;
    height: 36%;
    left: -5%;
    opacity: 0.78;
    pointer-events: none;
    position: absolute;
    width: 110%;
    z-index: 2;
  }

  .window-scene__mullion {
    background:
      linear-gradient(
        90deg,
        transparent 0 47%,
        rgba(6, 7, 9, 0.66) 47.5% 49.5%,
        rgba(255, 255, 255, 0.1) 50%,
        rgba(6, 7, 9, 0.72) 51% 53%,
        transparent 53.5%
      ),
      linear-gradient(
        90deg,
        transparent 0 84%,
        rgba(6, 7, 9, 0.62) 84.5% 86.5%,
        rgba(255, 255, 255, 0.12) 87%,
        transparent 88%
      );
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 5;
  }

  @keyframes city-pan {
    0%,
    100% {
      transform: scale(1.055) translate3d(-0.7%, 0, 0);
    }

    32% {
      transform: scale(1.065) translate3d(0.55%, -0.35%, 0);
    }

    68% {
      transform: scale(1.072) translate3d(0.8%, -0.75%, 0);
    }

    86% {
      transform: scale(1.062) translate3d(-0.25%, -0.25%, 0);
    }
  }

  @keyframes road-lights {
    0%,
    100% {
      opacity: 0.24;
    }

    46% {
      opacity: 0.34;
    }
  }

  @keyframes road-headlights {
    from {
      transform: translate3d(-18%, 0, 0);
    }

    to {
      transform: translate3d(28%, 0, 0);
    }
  }

  @keyframes road-tail-lights {
    from {
      transform: translate3d(24%, 0, 0);
    }

    to {
      transform: translate3d(-22%, 0, 0);
    }
  }

  @keyframes tail-lamps-near-flow {
    from {
      transform: rotate(-8deg) skewX(-16deg) translate3d(-10%, 0, 0);
    }

    to {
      transform: rotate(-8deg) skewX(-16deg) translate3d(18%, 0, 0);
    }
  }

  @keyframes tail-lamps-bend-flow {
    from {
      transform: rotate(-18deg) skewX(-18deg) translate3d(-8%, 0, 0);
    }

    to {
      transform: rotate(-18deg) skewX(-18deg) translate3d(14%, -8%, 0);
    }
  }

  @keyframes tail-lamps-far-flow {
    from {
      transform: rotate(-3deg) skewX(-8deg) translate3d(-6%, 0, 0);
    }

    to {
      transform: rotate(-3deg) skewX(-8deg) translate3d(10%, -3%, 0);
    }
  }

  @keyframes trees-breathe {
    0%,
    100% {
      transform: translate3d(-0.25%, 0, 0) scaleX(1);
      opacity: 0.76;
    }

    48% {
      transform: translate3d(0.42%, -0.28%, 0) scaleX(1.012);
      opacity: 0.86;
    }
  }

  @keyframes glass-reflection {
    0%,
    100% {
      opacity: 0.28;
      transform: translate3d(-6%, 0, 0);
    }

    48% {
      opacity: 0.42;
      transform: translate3d(5%, -1%, 0);
    }
  }

  @keyframes night-vignette {
    0%,
    100% {
      opacity: 0.78;
    }

    56% {
      opacity: 0.92;
    }
  }

  @keyframes city-bloom {
    0%,
    100% {
      opacity: 0.3;
    }

    46% {
      opacity: 0.48;
    }

    72% {
      opacity: 0.36;
    }
  }

  @keyframes lights-glimmer {
    0%,
    100% {
      opacity: 0.46;
      filter: blur(0.2px) brightness(1.02);
    }

    24% {
      opacity: 0.66;
      filter: blur(0.2px) brightness(1.22);
    }

    52% {
      opacity: 0.5;
      filter: blur(0.2px) brightness(1.08);
    }

    76% {
      opacity: 0.62;
      filter: blur(0.2px) brightness(1.18);
    }
  }

  @keyframes beacon-blink {
    0%,
    38%,
    100% {
      opacity: 0.18;
    }

    42%,
    54% {
      opacity: 1;
    }

    58%,
    70% {
      opacity: 0.28;
    }
  }

