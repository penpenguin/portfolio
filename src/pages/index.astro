---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { formatDate } from '../utils/formatDate';
import { sortPublishedPostsByDate } from '../utils/blog';

const projects = await getCollection('projects');
const [latestProject] = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const blogPosts = await getCollection('blog');
const [latestPost] = sortPublishedPostsByDate(blogPosts);
---

<Layout
  title="Portfolio - Programmer"
  description="プロフィール、制作物、技術メモ、連絡先をまとめたポートフォリオです。"
>
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid home-overview-grid">
        <section
          class="bento-hero bento-panel bento-card bento-card--intro card-glass"
        >
          <div class="intro-copy">
            <h1>About</h1>
            <p class="intro-role">
              Memos on systems, tools, and everyday experiments.
            </p>
          </div>
        </section>

        <section
          class="bento-panel bento-card bento-card--aquarium card-glass"
          aria-label="水縁 — SUIREN"
        >
          <iframe
            src="https://penpenguin.github.io/suiren-aquarium/"
            title="水縁 — SUIREN"
            loading="eager"
            sandbox="allow-scripts"
            allow="fullscreen"
            allowfullscreen></iframe>
        </section>

        {
          latestProject && (
            <section class="bento-panel bento-card bento-card--project card-glass">
              <div class="project-summary">
                <h2>
                  <Link href={`/projects/${latestProject.id}`}>
                    {latestProject.data.title}
                  </Link>
                </h2>
                <span class="project-card-meta">
                  {formatDate(latestProject.data.pubDate)}
                </span>
                <p>{latestProject.data.description}</p>
              </div>
              {latestProject.data.tags && (
                <div class="pill-list project-tags">
                  {latestProject.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/projects" class="overview-link project-index-link">
                Projects一覧を見る
              </Link>
            </section>
          )
        }

        {
          latestPost && (
            <section class="bento-panel bento-card bento-card--blog card-glass">
              <div class="blog-summary">
                <h2>
                  <Link href={`/blog/${latestPost.id}`}>
                    {latestPost.data.title}
                  </Link>
                </h2>
                <span class="blog-card-meta">
                  {formatDate(latestPost.data.pubDate)}
                </span>
                <p>{latestPost.data.description}</p>
              </div>
              {latestPost.data.tags && (
                <div class="pill-list blog-tags">
                  {latestPost.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/blog" class="overview-link project-index-link">
                Blog一覧を見る
              </Link>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-overview-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: auto;
    background: var(--bento-card-bg);
  }

  .bento-card--aquarium {
    grid-column: span 1;
    min-height: auto;
    padding: 0;
    background: var(--bento-card-bg);
    position: relative;
    overflow: hidden;
  }

  .bento-card--aquarium iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .bento-card--project {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--blog {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card h1 {
    max-width: 760px;
    margin: var(--space-sm) 0;
    font-size: 5.25rem;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .project-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .blog-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .project-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .blog-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .project-summary h2 a {
    color: var(--text-primary);
  }

  .blog-summary h2 a {
    color: var(--text-primary);
  }

  .project-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .blog-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .project-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .blog-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .intro-copy {
    max-width: 820px;
  }

  .intro-role {
    margin: var(--space-md) 0 0;
    color: var(--text-secondary);
    font-size: var(--font-size-lg);
  }

  .bento-card p {
    margin-bottom: 0;
  }

  .project-index-link {
    align-self: flex-start;
    margin-top: var(--space-lg);
  }

  .overview-link {
    color: var(--text-accent);
    flex: 0 0 auto;
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .overview-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 980px) {
    .home-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--intro,
    .bento-card--aquarium,
    .bento-card--project,
    .bento-card--blog {
      grid-column: span 2;
    }

    .bento-card--aquarium {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .home-overview-grid {
      grid-template-columns: 1fr;
    }

    .bento-card,
    .bento-card--intro,
    .bento-card--aquarium,
    .bento-card--project,
    .bento-card--blog {
      grid-column: span 1;
      min-height: auto;
    }

    .bento-card h1 {
      font-size: 3rem;
      line-height: 1.02;
    }
  }

  @media (max-width: 420px) {
    .bento-card h1 {
      font-size: 2.5rem;
    }
  }
</style>
