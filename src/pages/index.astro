---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/formatDate';
import { sortPublishedPostsByDate } from '../utils/blog';
import { withBase } from '../utils/withBase';

const projects = await getCollection('projects');
const [latestProject] = [...projects].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const blogPosts = await getCollection('blog');
const [latestPost] = sortPublishedPostsByDate(blogPosts);

const overviewCards = [
  {
    title: '経歴と技術スタック',
    description:
      '経験年数、技術スタック、担当領域、プロジェクト履歴を確認できます。',
    href: '/career',
    meta: 'Career summary',
  },
];

const playground = {
  title: 'Meaningless',
  previewImage: '/assets/projects/meaningless.webp',
  gameUrl: 'https://penpenguin.github.io/meaningless/',
};
---

<Layout
  title="Portfolio - Programmer"
  description="プロフィール、制作物、技術メモ、職務経歴、連絡先をまとめたポートフォリオです。"
>
  <section class="page-shell bento-shell">
    <div class="container">
      <div class="bento-grid home-overview-grid">
        <section
          class="bento-hero bento-panel bento-card bento-card--intro card-glass"
        >
          <div class="intro-copy">
            <h1>Enterprise systems, shipped end-to-end</h1>
            <p class="intro-role">Enterprise Systems Programmer</p>
          </div>
        </section>

        <section class="bento-panel bento-card bento-card--metric card-glass">
          <span class="metric-value">10+</span>
          <p class="metric-label">years in production systems</p>
          <p>要件定義から運用改善まで、長期運用される業務システムを支援。</p>
        </section>

        {
          latestProject && (
            <section class="bento-panel bento-card bento-card--project card-glass">
              <div class="project-summary">
                <h2>
                  <Link href={`/projects/${latestProject.id}`}>
                    {latestProject.data.title}
                  </Link>
                </h2>
                <span class="project-card-meta">
                  {formatDate(latestProject.data.pubDate)}
                </span>
                <p>{latestProject.data.description}</p>
              </div>
              {latestProject.data.tags && (
                <div class="pill-list project-tags">
                  {latestProject.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/projects" class="overview-link project-index-link">
                Projects一覧を見る
              </Link>
            </section>
          )
        }

        {
          overviewCards.map((card) => (
            <article class="bento-panel overview-card overview-card--career card-glass">
              <div>
                <h2>{card.title}</h2>
                <p>{card.description}</p>
              </div>
              <div class="overview-card__footer">
                <span>{card.meta}</span>
                <Link href={card.href} class="overview-link">
                  ページを見る
                </Link>
              </div>
            </article>
          ))
        }

        {
          latestPost && (
            <section class="bento-panel bento-card bento-card--blog card-glass">
              <div class="blog-summary">
                <h2>
                  <Link href={`/blog/${latestPost.id}`}>
                    {latestPost.data.title}
                  </Link>
                </h2>
                <span class="blog-card-meta">
                  {formatDate(latestPost.data.pubDate)}
                </span>
                <p>{latestPost.data.description}</p>
              </div>
              {latestPost.data.tags && (
                <div class="pill-list blog-tags">
                  {latestPost.data.tags.slice(0, 4).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
              <Link href="/blog" class="overview-link project-index-link">
                Blog一覧を見る
              </Link>
            </section>
          )
        }

        <section
          class="bento-panel bento-card bento-card--playground card-glass"
          data-playground-card
          data-game-src={playground.gameUrl}
        >
          <h2 class="playground-title">{playground.title}</h2>
          <div class="playground-preview" data-playground-preview>
            <img
              src={withBase(playground.previewImage)}
              alt="Meaningless aquarium app preview"
              width="960"
              height="540"
              loading="lazy"
              decoding="async"
            />
            <div class="playground-actions">
              <button
                class="playground-button"
                type="button"
                aria-label="Meaninglessを再生"
                data-playground-play-label="Meaninglessを再生"
                data-playground-close-label="Meaninglessを閉じる"
                data-playground-frame-title="Meaningless aquarium app preview"
                data-playground-toggle
              >
                <span class="playground-button__label">Play</span>
                <svg
                  class="playground-button__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M18 6 6 18"></path>
                  <path d="m6 6 12 12"></path>
                </svg>
              </button>
              <a
                class="overview-link"
                href={playground.gameUrl}
                target="_blank"
                rel="noreferrer"
              >
                別タブで開く
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script>
  const setupPlayground = () => {
    document
      .querySelectorAll<HTMLElement>('[data-playground-card]')
      .forEach((card) => {
        const playgroundPreview = card.querySelector<HTMLElement>(
          '[data-playground-preview]'
        );
        const playgroundToggle = card.querySelector<HTMLButtonElement>(
          '[data-playground-toggle]'
        );

        if (!playgroundPreview || !playgroundToggle) {
          return;
        }

        if (playgroundToggle.dataset.playgroundBound === 'true') {
          return;
        }

        playgroundToggle.dataset.playgroundBound = 'true';
        playgroundToggle.addEventListener('click', () => {
          const gameSrc = card.getAttribute('data-game-src');

          if (!gameSrc) {
            return;
          }

          const existingFrame = playgroundPreview.querySelector('iframe');
          const playLabel =
            playgroundToggle.dataset.playgroundPlayLabel ?? 'プレビューを再生';
          const closeLabel =
            playgroundToggle.dataset.playgroundCloseLabel ??
            'プレビューを閉じる';
          const frameTitle =
            playgroundToggle.dataset.playgroundFrameTitle ?? 'Playable preview';

          if (existingFrame) {
            existingFrame.remove();
            playgroundPreview.classList.remove('is-playing');
            playgroundToggle.setAttribute('aria-label', playLabel);
            return;
          }

          const frame = document.createElement('iframe');
          frame.className = 'playground-frame';
          frame.setAttribute('title', frameTitle);
          frame.setAttribute('loading', 'lazy');
          frame.setAttribute(
            'sandbox',
            'allow-scripts allow-same-origin allow-pointer-lock'
          );
          frame.setAttribute('referrerpolicy', 'no-referrer');
          frame.setAttribute('allow', 'fullscreen; gamepad');
          frame.setAttribute('src', gameSrc);
          playgroundPreview.append(frame);
          playgroundPreview.classList.add('is-playing');
          playgroundToggle.setAttribute('aria-label', closeLabel);
        });
      });
  };

  setupPlayground();
  document.addEventListener('astro:page-load', setupPlayground);
</script>

<style>
  .home-overview-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .bento-card,
  .overview-card {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bento-card--intro {
    grid-column: span 3;
    min-height: 390px;
    background: var(--bento-card-bg);
  }

  .bento-card--metric {
    grid-column: span 1;
    background: var(--text-primary);
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .bento-card--metric::after {
    content: '';
    position: absolute;
    right: -32px;
    bottom: -32px;
    width: 132px;
    height: 132px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
  }

  .bento-card--metric p {
    color: rgba(255, 255, 255, 0.78);
  }

  .bento-card--project {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--blog {
    grid-column: span 2;
    background: var(--bento-card-bg);
  }

  .bento-card--playground {
    grid-column: span 2;
    gap: var(--space-sm);
    justify-content: center;
    background: var(--bento-card-bg);
  }

  .overview-card--career {
    grid-column: span 2;
  }

  .bento-card h1,
  .overview-card h1 {
    max-width: 760px;
    margin: var(--space-sm) 0;
    font-size: 5.25rem;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .overview-card h2 {
    margin: 0 0 var(--space-sm) 0;
    color: var(--text-primary);
    font-size: var(--font-size-3xl);
  }

  .playground-title {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--font-size-2xl);
  }

  .project-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .blog-summary {
    display: grid;
    gap: var(--space-sm);
  }

  .project-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .blog-summary h2 {
    margin-bottom: 0;
    font-size: var(--font-size-3xl);
  }

  .project-summary h2 a {
    color: var(--text-primary);
  }

  .blog-summary h2 a {
    color: var(--text-primary);
  }

  .project-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .blog-card-meta {
    color: var(--text-accent);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .project-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .blog-tags span {
    color: var(--text-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .metric-label {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .metric-value {
    display: block;
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .intro-copy {
    max-width: 820px;
  }

  .intro-role {
    margin: var(--space-md) 0 0;
    color: var(--text-secondary);
    font-size: var(--font-size-lg);
  }

  .bento-card p,
  .overview-card p {
    margin-bottom: 0;
  }

  .project-index-link {
    align-self: flex-start;
    margin-top: var(--space-lg);
  }

  .playground-preview {
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
  }

  .playground-preview img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .playground-preview img {
    object-fit: cover;
  }

  :global(.playground-frame) {
    border: 0;
    inset: 0;
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .playground-preview.is-playing img {
    display: none;
  }

  .playground-actions {
    align-items: center;
    background: linear-gradient(180deg, transparent, rgba(15, 23, 42, 0.72));
    bottom: 0;
    display: flex;
    gap: var(--space-md);
    justify-content: space-between;
    left: 0;
    padding: var(--space-md);
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .playground-button {
    align-items: center;
    background: #ffffff;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: 700;
    justify-content: center;
    padding: 0.65rem 0.95rem;
  }

  .playground-button__icon {
    display: none;
    height: 1.2rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
    width: 1.2rem;
  }

  .playground-actions .overview-link {
    color: #ffffff;
  }

  .playground-preview.is-playing .playground-actions {
    background: transparent;
    bottom: auto;
    justify-content: flex-end;
    top: var(--space-xs);
    right: var(--space-xs);
    left: auto;
    padding: 0;
    pointer-events: none;
  }

  .playground-preview.is-playing .playground-button {
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.22);
    height: 2.5rem;
    padding: 0;
    pointer-events: auto;
    width: 2.5rem;
  }

  .playground-preview.is-playing .playground-button__label {
    display: none;
  }

  .playground-preview.is-playing .playground-button__icon {
    display: block;
  }

  .playground-preview.is-playing .overview-link {
    display: none;
  }

  .overview-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .overview-card__footer span {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .overview-link {
    color: var(--text-accent);
    flex: 0 0 auto;
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .overview-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 980px) {
    .home-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--intro,
    .bento-card--project,
    .bento-card--blog,
    .bento-card--playground {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .home-overview-grid {
      grid-template-columns: 1fr;
    }

    .bento-card,
    .bento-card--intro,
    .bento-card--metric,
    .bento-card--project,
    .bento-card--blog,
    .bento-card--playground,
    .overview-card {
      grid-column: span 1;
      min-height: auto;
    }

    .bento-card h1,
    .overview-card h1 {
      font-size: 3rem;
      line-height: 1.02;
    }

    .overview-card__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-sm);
    }
  }

  @media (max-width: 420px) {
    .bento-card h1,
    .overview-card h1 {
      font-size: 2.5rem;
    }
  }
</style>
