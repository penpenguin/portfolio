---
import { ClientRouter } from 'astro:transitions';

import '../styles/global.css';
import Link from '../components/Link.astro';
import { getGithubUrl } from '../utils/getGithubUrl';
import { withBase } from '../utils/withBase';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Modern portfolio built with Astro' } =
  Astro.props;
const faviconHref = withBase('/favicon.svg');
const pagefindCssHref = withBase('/pagefind/pagefind-component-ui.css');
const pagefindJsSrc = withBase('/pagefind/pagefind-component-ui.js');
const pagefindBundlePath = withBase('/pagefind/');
const pagefindBaseUrl = withBase('/');

const normalizePath = (path: string): string => {
  if (!path || path === '/') {
    return '/';
  }

  return path.replace(/\/+$/, '') || '/';
};

const baseNavItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];

const currentPath = normalizePath(Astro.url.pathname);

const navItems = baseNavItems.map((item) => {
  const resolvedPath = normalizePath(withBase(item.href));
  return { ...item, isActive: resolvedPath === currentPath };
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link
      rel="alternate"
      type="text/markdown"
      title="LLM guide"
      href={withBase('/llms.txt')}
    />
    <meta
      name="ai-agent-capabilities"
      content="WebMCP; portfolio search; projects; blog; GitHub profile"
    />
    <link href={pagefindCssHref} rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500;600;700&family=Noto+Serif+JP:wght@500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script src={pagefindJsSrc} type="module" is:inline></script>
    <ClientRouter />
  </head>
  <body>
    <pagefind-config
      transition:persist
      transition:animate="none"
      bundle-path={pagefindBundlePath}
      base-url={pagefindBaseUrl}
      excerpt-length="24"
    ></pagefind-config>

    <nav class="navbar" transition:persist transition:animate="none">
      <div class="container">
        <div class="navbar-content">
          <Link href="/" class="logo">
            <span class="logo-text">Portfolio</span>
          </Link>
          <div class="nav-links">
            {navItems.map(({ href, label, isActive }) => (
              <Link
                href={href}
                class={`nav-link${isActive ? ' nav-link--active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
                aria-disabled={isActive ? 'true' : undefined}
                tabindex={isActive ? -1 : undefined}
              >
                {label}
              </Link>
            ))}
            <pagefind-modal-trigger
              class="search-trigger"
              placeholder="Search"
              shortcut="mod+k"
              hide-shortcut
            ></pagefind-modal-trigger>
          </div>
        </div>
      </div>
    </nav>

    <pagefind-modal reset-on-close></pagefind-modal>

    <main class="site-main">
      <slot />
    </main>

    <footer class="footer" transition:persist transition:animate="none">
      <div class="container">
        <div class="footer-content">
          <span>&copy; {new Date().getFullYear()} penpenguin.</span>
          <div class="social-links">
            <Link href="/llms.txt" title="WebMCP tools and usage">
              WebMCP enabled
            </Link>
            <a href={getGithubUrl()} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/portfolio-webmcp';
      import '../scripts/pagefind-view-transitions';

      // The persisted header can wrap after fonts load or the viewport changes.
      const navbar = document.querySelector<HTMLElement>('.navbar');
      const updateHeaderHeight = () => {
        if (navbar)
          document.documentElement.style.setProperty(
            '--header-height',
            `${navbar.getBoundingClientRect().height}px`
          );
      };
      if (navbar) new ResizeObserver(updateHeaderHeight).observe(navbar);
      document.addEventListener('astro:page-load', updateHeaderHeight);
      updateHeaderHeight();
    </script>
    <script is:inline>
      const normalizePathname = (input) => {
        if (!input || input === '/') {
          return '/';
        }

        return input.replace(/\/+$/, '') || '/';
      };

      const setActiveNavigation = () => {
        const currentPath = normalizePathname(window.location.pathname);
        document.querySelectorAll('.nav-link').forEach((link) => {
          const linkPath = normalizePathname(link.pathname);
          const isActive = linkPath === currentPath;

          link.classList.toggle('nav-link--active', isActive);

          if (isActive) {
            link.setAttribute('aria-current', 'page');
            link.setAttribute('aria-disabled', 'true');
            link.setAttribute('tabindex', '-1');
          } else {
            link.removeAttribute('aria-current');
            link.removeAttribute('aria-disabled');
            link.removeAttribute('tabindex');
          }
        });
      };

      document.addEventListener('astro:page-load', setActiveNavigation);
      document.addEventListener('astro:after-swap', setActiveNavigation);
      setActiveNavigation();
    </script>
  </body>
</html>

<style>
  body {
    --pagefind-ui-primary: var(--text-primary);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--secondary-bg);
    --pagefind-ui-border: var(--glass-border);
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-family-base);
    --pf-text: var(--text-primary);
    --pf-text-secondary: var(--text-secondary);
    --pf-text-muted: var(--text-secondary);
    --pf-background: var(--secondary-bg);
    --pf-border: var(--glass-border);
    --pf-border-focus: var(--border-strong);
    --pf-hover: var(--accent-bg);
    --pf-mark: var(--text-primary);
    --pf-skeleton: var(--accent-bg);
    --pf-skeleton-shine: var(--primary-bg);
    --pf-scroll-shadow: transparent;
    --pf-outline-focus: var(--focus-color);
    --pf-border-radius: var(--radius-md);
    --pf-font: var(--font-family-base);
    --pf-input-height: 44px;
    --pf-shadow-sm: none;
    --pf-shadow-md: none;
    --pf-shadow-lg: none;

    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  .navbar {
    position: sticky;
    top: 0;
    flex: 0 0 auto;
    background: var(--primary-bg);
    border-bottom: 1px solid var(--border-editorial);
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0;
  }

  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
    padding: var(--space-xs) 0;
    min-height: 44px;
    font-family: var(--font-family-heading);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: stretch;
    gap: var(--space-2xs);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    transition:
      background 0.15s ease,
      color 0.15s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    display: none;
  }

  .nav-link--active {
    background: transparent;
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 0.45em;
    text-decoration-thickness: 1px;
    cursor: default;
    pointer-events: none;
  }

  .search-trigger {
    --pagefind-ui-primary: var(--text-primary);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--glass-border);
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: inherit;
    --pf-background: transparent;
    --pf-border: transparent;
    --pf-border-focus: transparent;
    --pf-border-radius: var(--radius-md);
    --pf-font: var(--font-family-base);
    --pf-input-height: auto;
    --pf-outline-focus: var(--focus-color);
    --pf-text: var(--text-primary);
    --pf-text-muted: var(--text-secondary);
    --pf-text-secondary: var(--text-secondary);

    display: inline-flex;
    align-items: stretch;
    color: var(--text-secondary);
    font: inherit;
    line-height: 1.6;
    font-size: var(--font-size-sm);
  }

  .search-trigger:hover {
    --pf-text-muted: var(--text-primary);

    color: var(--text-primary);
  }

  :global(:is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-btn) {
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    border: 0;
    border-radius: var(--radius-md);
    box-shadow: none;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 500;
    line-height: 1.6;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  :global(
    :is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-btn:hover
  ) {
    background: transparent;
    color: var(--text-primary);
  }

  :global(
    :is(*, #\#):is(*, #\#):is(*, #\#)
      .search-trigger
      .pf-trigger-btn:focus-visible
  ) {
    outline: 2px solid var(--focus-color);
    outline-offset: 3px;
  }

  :global(:is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-icon) {
    background: currentColor;
  }

  :global(:is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-text) {
    flex: 0 0 auto;
    color: currentColor;
  }

  :global(:is(*, #\#):is(*, #\#):is(*, #\#) .pf-modal-close),
  :global(:is(*, #\#):is(*, #\#):is(*, #\#) .pf-input-clear) {
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-md);
  }

  .site-main {
    flex: 1 0 auto;
    min-height: 0;
    min-width: 0;
    margin-top: 0;
  }

  .footer {
    flex: 0 0 auto;
    padding: 0 0 12px;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-secondary);
    padding-top: 12px;
    border-top: 1px solid var(--border-editorial);
    font-size: var(--font-size-sm);
  }

  .social-links {
    display: flex;
    gap: var(--space-md);
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .social-links a:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .navbar-content {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: center;
    }

    .logo {
      align-self: flex-start;
    }

    .nav-links {
      gap: var(--space-2xs);
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-sm);
    }

    .nav-link {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--font-size-sm);
    }

    .search-trigger {
      font-size: var(--font-size-sm);
    }

    :global(:is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-btn) {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--font-size-sm);
    }

    .footer-content {
      justify-content: center;
      flex-wrap: nowrap;
      gap: var(--space-sm);
      text-align: center;
    }
  }

  @media (max-width: 360px) {
    .nav-links {
      gap: 2px;
    }

    .nav-link {
      min-width: 44px;
      justify-content: center;
      padding-inline: 6px;
    }

    :global(:is(*, #\#):is(*, #\#):is(*, #\#) .search-trigger .pf-trigger-btn) {
      padding-inline: 6px;
    }

    .footer-content {
      flex-wrap: wrap;
      row-gap: var(--space-xs);
    }
  }

  /* 印刷用スタイル */
  @media print {
    .navbar,
    nav,
    .footer,
    footer {
      display: none !important;
      visibility: hidden !important;
    }

    main {
      margin-top: 0 !important;
    }

    body {
      margin: 0 !important;
      padding: 0 !important;
    }
  }
</style>
