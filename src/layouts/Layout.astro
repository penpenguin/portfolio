---
import '../styles/global.css';
import Link from '../components/Link.astro';
import { withBase } from '../utils/withBase';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Modern portfolio built with Astro' } =
  Astro.props;
const faviconHref = withBase('/favicon.svg');

const normalizePath = (path: string): string => {
  if (!path || path === '/') {
    return '/';
  }

  return path.replace(/\/+$/, '') || '/';
};

const baseNavItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/career', label: 'Career' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = normalizePath(Astro.url.pathname);

const navItems = baseNavItems.map((item) => {
  const resolvedPath = normalizePath(withBase(item.href));
  return { ...item, isActive: resolvedPath === currentPath };
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <nav class="navbar" transition:persist transition:animate="none">
      <div class="container">
        <div class="navbar-content">
          <Link href="/" class="logo">
            <span class="logo-text">Portfolio</span>
          </Link>
          <div class="nav-links">
            {
              navItems.map(({ href, label, isActive }) => (
                <Link
                  href={href}
                  class={`nav-link${isActive ? ' nav-link--active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                  aria-disabled={isActive ? 'true' : undefined}
                  tabindex={isActive ? -1 : undefined}
                >
                  {label}
                </Link>
              ))
            }
          </div>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer" transition:persist transition:animate="none">
      <div class="container">
        <div class="footer-content">
          <span>&copy; {new Date().getFullYear()} penpenguin.</span>
          <div class="social-links">
            <a
              href={import.meta.env.PUBLIC_GITHUB_URL || 'https://github.com'}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/portfolio-webmcp';
    </script>
    <script is:inline>
      const normalizePathname = (input) => {
        if (!input || input === '/') {
          return '/';
        }

        return input.replace(/\/+$/, '') || '/';
      };

      const setActiveNavigation = () => {
        const currentPath = normalizePathname(window.location.pathname);
        document.querySelectorAll('.nav-link').forEach((link) => {
          const linkPath = normalizePathname(link.pathname);
          const isActive = linkPath === currentPath;

          link.classList.toggle('nav-link--active', isActive);

          if (isActive) {
            link.setAttribute('aria-current', 'page');
            link.setAttribute('aria-disabled', 'true');
            link.setAttribute('tabindex', '-1');
          } else {
            link.removeAttribute('aria-current');
            link.removeAttribute('aria-disabled');
            link.removeAttribute('tabindex');
          }
        });
      };

      document.addEventListener('astro:page-load', setActiveNavigation);
      document.addEventListener('astro:after-swap', setActiveNavigation);
      setActiveNavigation();
    </script>
  </body>
</html>

<style>
  body {
    --nav-offset: 96px;

    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .navbar {
    position: fixed;
    top: var(--space-sm);
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0;
    pointer-events: none;
  }

  .navbar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    pointer-events: auto;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-2xs);
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-md);
    transition:
      background 0.2s ease,
      color 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    display: none;
  }

  .nav-link--active {
    background: var(--text-primary);
    color: #ffffff;
    cursor: default;
    pointer-events: none;
  }

  main {
    margin-top: var(--nav-offset);
    min-height: calc(100vh - 160px);
    flex: 1;
  }

  .footer {
    padding: var(--space-lg) 0 var(--space-md);
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-secondary);
    padding-top: var(--space-md);
    border-top: 1px solid var(--glass-border);
    font-size: var(--font-size-sm);
  }

  .social-links {
    display: flex;
    gap: var(--space-md);
  }

  .social-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--text-accent);
  }

  @media (max-width: 768px) {
    body {
      --nav-offset: 132px;
    }

    .navbar-content {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: center;
    }

    .nav-links {
      gap: var(--space-2xs);
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-sm);
    }

    .nav-link {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--font-size-sm);
    }

    .footer-content {
      justify-content: center;
      flex-wrap: nowrap;
      gap: var(--space-sm);
      text-align: center;
    }
  }

  @media (max-width: 360px) {
    .footer-content {
      flex-wrap: wrap;
      row-gap: var(--space-xs);
    }
  }

  /* 印刷用スタイル */
  @media print {
    .navbar,
    nav,
    .footer,
    footer {
      display: none !important;
      visibility: hidden !important;
    }

    main {
      margin-top: 0 !important;
    }

    body {
      margin: 0 !important;
      padding: 0 !important;
    }
  }
</style>
