{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "description": "Modern portfolio website built with Astro",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "preview:search": "npm run build && astro preview",
    "test": "vitest",
    "test:visual": "node scripts/run-playwright-visual.mjs",
    "check": "astro check && tsc",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.3.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@types/node": "24.19.2",
    "eslint": "10.6.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "pagefind": "1.5.2",
    "prettier": "3.8.5",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.11"
  },
  "private": true,
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": "^24.22.0",
    "npm": ">=11.10.0"
  }
}
