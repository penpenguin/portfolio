{
  "name": "portfolio",
  "type": "module",
  "version": "1.0.0",
  "description": "Modern portfolio website built with Astro",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "preview:search": "npm run build && astro preview",
    "test": "vitest",
    "test:visual": "node scripts/run-playwright-visual.mjs",
    "check": "astro check && tsc",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": "^26.12.1",
    "npm": ">=11.10.0"
  }
}
